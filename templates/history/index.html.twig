{% extends 'base.html.twig' %}

{% set tabLabels = {
    all: selectedMode == 'driver' ? 'Tous les trajets crees' : 'Tous les trajets reserves',
    active: selectedMode == 'driver' ? 'Trajets actifs' : 'Trajets a venir',
    old: selectedMode == 'driver' ? 'Anciens trajets' : 'Trajets passes'
} %}
{% set statusLabels = {
    planned: 'Planifie',
    in_progress: 'En cours',
    arrived: 'Arrive',
    completed: 'Complété',
    disputed: 'Litige',
    canceled: 'Annule'
} %}

{% block title %}Historique des trajets{% endblock %}

{% block body %}
<div class="container py-5 mw-1200px">
    <div class="travel-hero p-4 p-md-5 mb-4 rounded-4 shadow-sm bg-white border">
        <h1 class="h2 fw-bold mb-2 text-dark">Historique des trajets</h1>
        <p class="fs-6 text-muted mb-0">
            {% if selectedMode == 'driver' %}
                Retrouvez tous les trajets que vous avez proposes, classes par statut.
            {% elseif isPassenger %}
                Retrouvez les trajets auxquels vous avez participe, classes par statut.
            {% else %}
                Cette page affichera vos trajets proposes des que vous utiliserez un profil conducteur.
            {% endif %}
        </p>
    </div>

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('info') %}
        <div class="alert alert-info">{{ message }}</div>
    {% endfor %}

    {% if not isHistoryAvailable %}
        <div class="d-flex flex-column align-items-center text-center p-5 bg-light rounded-4 custom-empty-state mb-4">
            <div class="display-6 text-muted mb-3 fw-light">Historique</div>
            <h2 class="h4 fw-bold mb-2">Aucun historique disponible pour le moment</h2>
            <p class="text-muted mb-4 fs-6">
                Cette page affichera vos trajets des que votre profil vous permettra de proposer ou reserver un trajet.
            </p>
            <a href="{{ path('app_profile') }}" class="btn btn-vert px-4 py-2 rounded-3">Mettre a jour mon profil</a>
        </div>
    {% else %}
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
            {% if availableModes|length > 1 %}
                <div class="d-flex flex-wrap gap-2 mb-4">
                    <a
                        href="{{ path('app_history', {mode: 'driver', tab: selectedTab, q: selectedMode == 'driver' ? search : ''}) }}"
                        class="btn {{ selectedMode == 'driver' ? 'btn-vert' : 'btn-details' }}"
                        
                    >
                        Historique conducteur
                    </a>
                    <a
                        href="{{ path('app_history', {mode: 'passenger', tab: selectedTab, q: selectedMode == 'passenger' ? search : ''}) }}"
                        class="btn {{ selectedMode == 'passenger' ? 'btn-vert' : 'btn-details' }}"
                        
                    >
                        Historique passager
                    </a>
                </div>
            {% endif %}

            <div class="d-flex flex-wrap gap-2 mb-4">
                {% for tabKey, tabLabel in tabLabels %}
                    <a
                        href="{{ path('app_history', {mode: selectedMode, tab: tabKey, q: tabKey == selectedTab ? search : ''}) }}"
                        class="btn {{ selectedTab == tabKey ? 'btn-vert' : 'btn-details' }}"
                        
                    >
                        {{ tabLabel }} ({{ tabCounts[tabKey] }})
                    </a>
                {% endfor %}
            </div>

            <form method="get" action="{{ path('app_history') }}" class="mb-0">
                <input type="hidden" name="mode" value="{{ selectedMode }}">
                <input type="hidden" name="tab" value="{{ selectedTab }}">
                <div class="bg-light border rounded-4 p-3 mt-3">
                    <div class="row g-3 align-items-center w-100 m-0">
                        <div class="col-12 col-lg px-0 px-lg-2">
                            <label class="form-label small text-muted fw-bold mb-1">Recherche</label>
                            <input
                                type="text"
                                name="q"
                                class="form-control border-0 shadow-none rounded-3 py-2"
                                value="{{ search }}"
                                placeholder="{{ selectedMode == 'driver' ? 'Ville de départ, destination, date, statut, véhicule...' : 'Ville de départ, destination, date, statut, conducteur, véhicule...' }}"
                            />
                        </div>
                        <div class="col-12 col-lg-auto px-0 px-lg-2 mt-3 mt-lg-0 d-flex align-items-end">
                            <div class="d-flex gap-2 w-100 mt-lg-4 pt-lg-1">
                                <button type="submit" class="btn btn-primary rounded-3 px-4 py-2 flex-grow-1 flex-lg-grow-0">Rechercher</button>
                                <a href="{{ path('app_history', {mode: selectedMode, tab: selectedTab}) }}" class="btn btn-outline-secondary rounded-3 px-4 py-2 text-decoration-none flex-grow-1 flex-lg-grow-0 text-center">Reinitialiser</a>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <div class="d-flex justify-content-between align-items-end border-bottom pb-2 mb-3 mt-4">
            <h2 class="h5 fw-bold mb-0 text-dark">{{ tabLabels[selectedTab] }}</h2>
            <span class="badge bg-secondary rounded-pill fw-normal">{{ trips|length }} résultat{{ trips|length > 1 ? 's' }}</span>
        </div>

        {% if trips is empty %}
            <div class="d-flex flex-column align-items-center text-center p-5 bg-light rounded-4 custom-empty-state mb-4">
                <div class="display-6 text-muted mb-3 fw-light">Aucun trajet</div>
                <h3 class="h5 fw-bold mb-2">Aucun trajet correspondant</h3>
                <p class="text-muted mb-0 fs-6">
                    Aucun trajet ne correspond a votre recherche dans cet onglet.
                </p>
            </div>
        {% else %}
            {% for trip in trips %}
                <a href="{{ path('app_trip_show', {id: trip.id}) }}" class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center p-4 mb-3 bg-white border rounded-4 text-decoration-none text-dark shadow-sm custom-trip-card">
                    <div class="d-flex align-items-center gap-3 mb-3 mb-md-0">
                        <div class="d-flex align-items-center justify-content-center rounded-circle bg-primary text-white fw-bold flex-shrink-0" style="width: 48px; height: 48px; font-size: 1.1rem;">
                            {{ app.user.username|slice(0, 2)|upper }}
                        </div>
                        <div>
                            <div class="h6 fw-bold mb-2 d-flex align-items-center gap-2 flex-wrap">
                                {{ trip.departureLocation }} <span class="text-muted mx-1">&rarr;</span> {{ trip.arrivalLocation }}
                                {% if trip.status == 'canceled' %}
                                    <span class="badge bg-danger-subtle text-danger rounded-pill fw-normal px-2 py-1">Annule</span>
                                {% elseif trip.status == 'completed' %}
                                    <span class="badge bg-success-subtle text-success rounded-pill fw-normal px-2 py-1">Complété</span>
                                {% elseif selectedTab == 'active' %}
                                    <span class="badge bg-primary-subtle text-primary rounded-pill fw-normal px-2 py-1">Actif</span>
                                {% endif %}
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-2 text-muted small">
                                <span>{{ trip.departureDate|date('d M Y') }}</span>
                                <span class="text-muted opacity-50">&bull;</span>
                                <span>{{ trip.departureTime|date('H:i') }} &rarr; {{ trip.arrivalTime|date('H:i') }}</span>
                                <span class="text-muted opacity-50">&bull;</span>
                                <span>{{ trip.availableSeats }} place{{ trip.availableSeats > 1 ? 's' }}</span>
                                <span class="text-muted opacity-50">&bull;</span>
                                <span>Statut: {{ statusLabels[trip.status]|default(trip.status) }}</span>
                                {% if selectedMode == 'passenger' and trip.driver %}
                                    <span class="text-muted opacity-50">&bull;</span>
                                    <span>Conducteur: {{ trip.driver.username }}</span>
                                {% endif %}
                                {% if trip.vehicle %}
                                    <span class="text-muted opacity-50">&bull;</span>
                                    <span>
                                        {{ trip.vehicle.brand ? trip.vehicle.brand.label ~ ' ' : '' }}{{ trip.vehicle.model }}
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    <div class="d-flex flex-row flex-md-column align-items-center align-items-md-end justify-content-between w-100 w-md-auto gap-2 mt-2 mt-md-0">
                        <div class="text-md-end d-flex flex-row flex-md-column align-items-center align-items-md-end gap-2 gap-md-0">
                            <div class="h5 fw-bold text-success mb-0">{{ trip.pricePerPerson }} credits</div>
                            <div class="small text-muted">par passager</div>
                        </div>
                        <span class="btn btn-outline-secondary btn-sm rounded-pill px-3">Voir le trajet</span>
                    </div>
                </a>
            {% endfor %}
        {% endif %}
    {% endif %}
</div>
{% endblock %}
