<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>
			{% block title %}EcoRide
			{% endblock %}
		</title>
		<link
		rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>"/>
		{# Bootstrap CSS (mobile‑first framework) #}
		<link rel="preconnect" href="https://fonts.googleapis.com"/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
		<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
		<link
		href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
		{# Bootstrap Icons #}
		<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
		<link rel="stylesheet" href="{{ asset('css/style.css') }}"/>
		<link rel="stylesheet" href="{{ asset('css/trip.css') }}"/> {% block stylesheets %}{% endblock %}

		{% block javascripts %}
			{% block importmap %}
				{{ importmap('app') }}
			{% endblock %}
		{% endblock %}
	</head>
	<body class="d-flex flex-column min-vh-100">
		{% block header %}
			{% include 'partials/_header.html.twig' %}
		{% endblock %}
		<main class="container-fluid flex-grow-1 px-0"> {% block body %}{% endblock %}
			</main>
			{% block footer %}
				{% include 'partials/_footer.html.twig' %}
			{% endblock %}
			<div class="modal fade" id="siteConfirmModal" tabindex="-1" aria-labelledby="siteConfirmModalLabel" aria-hidden="true">
				<div class="modal-dialog modal-dialog-centered">
					<div class="modal-content bg-dark text-light border-secondary shadow">
						<div class="modal-header border-0 pb-0">
							<h5 class="modal-title" id="siteConfirmModalLabel">Confirmer l action</h5>
							<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
						</div>
						<div class="modal-body pt-2">
							<p class="mb-0" data-confirm-message>Voulez-vous continuer ?</p>
						</div>
						<div class="modal-footer border-0 pt-0">
							<button type="button" class="btn btn-outline-light rounded-pill px-4" data-bs-dismiss="modal">Retour</button>
							<button type="button" class="btn btn-danger rounded-pill px-4" data-confirm-submit>Confirmer</button>
						</div>
					</div>
				</div>
			</div>
			{% block javascript %}
				<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
				<script type="module" src="{{ asset('js/ecoride.js') }}"></script>
				<script type="module" src="{{ asset('js/confirm-dialog.js') }}"></script>
			{% endblock %}

		</body>
	</html>
