{% extends 'base.html.twig' %}

{% block title %}Creer un compte | EcoRide{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .custom-pill {
            background-color: rgba(124, 219, 130, 0.1) !important;
            color: #7cdb82 !important;
            border: 1px solid rgba(124, 219, 130, 0.2) !important;
            font-size: 0.75rem !important;
            letter-spacing: 0.05em;
        }
        .custom-input {
            background: #181c21 !important;
            border: 1px solid #32353b !important;
            color: #e0e2ea !important;
            transition: all 0.18s ease;
        }
        .custom-input:focus {
            border-color: rgba(124,219,130,0.5) !important;
            box-shadow: 0 0 0 3px rgba(124, 219, 130, 0.1) !important;
        }
        .custom-input::placeholder {
            color: #5a6458 !important;
        }
        .btn-primary-custom {
            background: linear-gradient(135deg, #7adf7e, #86e683);
            color: #00390f !important;
            box-shadow: 0 10px 28px rgba(124, 219, 130, 0.25);
            transition: all 0.2s ease;
        }
        .btn-primary-custom:hover {
            background: linear-gradient(135deg, #86e683, #97f08f);
            transform: translateY(-1px);
        }
        .link-custom {
            color: #7cdb82;
            transition: color 0.2s ease;
        }
        .link-custom:hover {
            color: #97f08f;
        }
        .btn-toggle-password {
            transition: color 0.2s ease;
        }
        .btn-toggle-password:hover {
            color: #7cdb82 !important;
        }
    </style>
{% endblock %}

{% block body %}
<section class="d-flex align-items-center justify-content-center min-vh-100 py-5" style="background-color: #0b0e14;" data-bs-theme="dark">
    <div class="w-100 px-3" style="max-width: 600px;">
        <div class="text-center mb-5">
            <span class="badge rounded-pill custom-pill text-uppercase px-3 py-2 mb-3 fw-bold">Rejoignez la communaute</span>
            <h1 class="fw-bold text-white mb-3" style="font-size: clamp(1.8rem, 4vw, 2.5rem); letter-spacing: -0.02em;">Creer un compte</h1>
            <p class="text-white-50 fs-6 mb-0 lh-lg">Voyagez malin, voyagez ensemble, et entrez dans l'experience premium EcoRide.</p>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success d-flex align-items-center gap-3 rounded-4 border border-success border-opacity-25" style="background: rgba(25, 135, 84, 0.1); color: #7cdb82;">
                <i class="bi bi-check-circle fs-5"></i>
                <div>{{ message }}</div>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger d-flex align-items-center gap-3 rounded-4 border border-danger border-opacity-25" style="background: rgba(220, 53, 69, 0.1); color: #ea868f;">
                <i class="bi bi-exclamation-circle fs-5"></i>
                <div>{{ message }}</div>
            </div>
        {% endfor %}

        {% for message in app.flashes('verify_email_error') %}
            <div class="alert alert-danger d-flex align-items-center gap-3 rounded-4 border border-danger border-opacity-25" style="background: rgba(220, 53, 69, 0.1); color: #ea868f;">
                <i class="bi bi-exclamation-circle fs-5"></i>
                <div>{{ message }}</div>
            </div>
        {% endfor %}

        <div class="card bg-transparent border-0 rounded-5 shadow-lg w-100" style="background: #1c2025 !important; border: 1px solid #32353b !important;">
            <div class="card-body p-4 p-lg-5">
            {{ form_start(registrationForm, { attr: { class: 'd-flex flex-column gap-4' } }) }}
                {{ form_errors(registrationForm) }}

                <div class="row g-4">
                    <div class="col-md-6 d-flex flex-column gap-2">
                        <label class="form-label text-uppercase fw-bold mb-0 ps-1" for="{{ registrationForm.firstName.vars.id }}" style="font-size: 0.7rem; color: #9aa49a; letter-spacing: 0.08em;">Prenom</label>
                        <div class="position-relative">
                            <i class="bi bi-person position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                            {{ form_widget(registrationForm.firstName, { attr: { class: 'form-control custom-input px-3 py-3 rounded-3 shadow-none', style: 'padding-left: 2.75rem !important;' } }) }}
                        </div>
                        {{ form_errors(registrationForm.firstName) }}
                    </div>

                    <div class="col-md-6 d-flex flex-column gap-2">
                        <label class="form-label text-uppercase fw-bold mb-0 ps-1" for="{{ registrationForm.lastName.vars.id }}" style="font-size: 0.7rem; color: #9aa49a; letter-spacing: 0.08em;">Nom</label>
                        <div class="position-relative">
                            <i class="bi bi-person position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                            {{ form_widget(registrationForm.lastName, { attr: { class: 'form-control custom-input px-3 py-3 rounded-3 shadow-none', style: 'padding-left: 2.75rem !important;' } }) }}
                        </div>
                        {{ form_errors(registrationForm.lastName) }}
                    </div>
                </div>

                <div class="d-flex flex-column gap-2">
                    <label class="form-label text-uppercase fw-bold mb-0 ps-1" for="{{ registrationForm.email.vars.id }}" style="font-size: 0.7rem; color: #9aa49a; letter-spacing: 0.08em;">Email</label>
                    <div class="position-relative">
                        <i class="bi bi-envelope position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                        {{ form_widget(registrationForm.email, { attr: { class: 'form-control custom-input px-3 py-3 rounded-3 shadow-none', style: 'padding-left: 2.75rem !important;' } }) }}
                    </div>
                    {{ form_errors(registrationForm.email) }}
                </div>

                <div class="d-flex flex-column gap-2">
                    <label class="form-label text-uppercase fw-bold mb-0 ps-1" for="{{ registrationForm.phone.vars.id }}" style="font-size: 0.7rem; color: #9aa49a; letter-spacing: 0.08em;">Telephone</label>
                    <div class="position-relative">
                        <i class="bi bi-telephone position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                        {{ form_widget(registrationForm.phone, { attr: { class: 'form-control custom-input px-3 py-3 rounded-3 shadow-none', style: 'padding-left: 2.75rem !important;' } }) }}
                    </div>
                    {{ form_errors(registrationForm.phone) }}
                </div>

                <div class="d-flex flex-column gap-2">
                    <label class="form-label text-uppercase fw-bold mb-0 ps-1" for="{{ registrationForm.plainPassword.first.vars.id }}" style="font-size: 0.7rem; color: #9aa49a; letter-spacing: 0.08em;">Mot de passe</label>
                    <div class="position-relative">
                        <i class="bi bi-lock position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                        {{ form_widget(registrationForm.plainPassword.first, {
                            attr: {
                                class: 'form-control custom-input px-3 py-3 rounded-3 shadow-none',
                                style: 'padding-left: 2.75rem !important; padding-right: 2.75rem !important;',
                                oninput: 'checkStrength(this.value)'
                            }
                        }) }}
                        <button type="button" onclick="togglePassword('{{ registrationForm.plainPassword.first.vars.id }}', this)" class="btn position-absolute top-50 end-0 translate-middle-y me-1 text-white-50 border-0 shadow-none btn-toggle-password" aria-label="Afficher le mot de passe">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <div class="d-flex gap-2 mt-1" id="strength-bars">
                        <div class="strength-bar flex-fill rounded-pill" style="height: 4px; background-color: #32353b; transition: all 0.3s ease;"></div>
                        <div class="strength-bar flex-fill rounded-pill" style="height: 4px; background-color: #32353b; transition: all 0.3s ease;"></div>
                        <div class="strength-bar flex-fill rounded-pill" style="height: 4px; background-color: #32353b; transition: all 0.3s ease;"></div>
                        <div class="strength-bar flex-fill rounded-pill" style="height: 4px; background-color: #32353b; transition: all 0.3s ease;"></div>
                    </div>
                    <p id="strength-label" class="text-white-50 small mt-1 mb-0 lh-sm"></p>
                    {{ form_errors(registrationForm.plainPassword.first) }}
                </div>

                <div class="d-flex flex-column gap-2">
                    <label class="form-label text-uppercase fw-bold mb-0 ps-1" for="{{ registrationForm.plainPassword.second.vars.id }}" style="font-size: 0.7rem; color: #9aa49a; letter-spacing: 0.08em;">Confirmer le mot de passe</label>
                    <div class="position-relative">
                        <i class="bi bi-shield-lock position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                        {{ form_widget(registrationForm.plainPassword.second, {
                            attr: {
                                class: 'form-control custom-input px-3 py-3 rounded-3 shadow-none',
                                style: 'padding-left: 2.75rem !important; padding-right: 2.75rem !important;',
                                oninput: 'checkMatch()'
                            }
                        }) }}
                        <button type="button" onclick="togglePassword('{{ registrationForm.plainPassword.second.vars.id }}', this)" class="btn position-absolute top-50 end-0 translate-middle-y me-1 text-white-50 border-0 shadow-none btn-toggle-password" aria-label="Afficher le mot de passe">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <p id="match-label" class="text-white-50 small mt-1 mb-0 lh-sm"></p>
                    {{ form_errors(registrationForm.plainPassword.second) }}
                </div>

                <div class="form-check d-flex align-items-start gap-2 mt-2 mb-2">
                    {{ form_widget(registrationForm.agreeTerms, { attr: { class: 'form-check-input shadow-none mt-1', style: 'cursor: pointer;' } }) }}
                    <label class="form-check-label text-white-50 small" for="{{ registrationForm.agreeTerms.vars.id }}" style="cursor: pointer; line-height: 1.5;">
                        J'accepte les conditions d'utilisation et la politique de confidentialite
                    </label>
                    {{ form_errors(registrationForm.agreeTerms) }}
                </div>

                <button type="submit" class="btn btn-primary-custom rounded-pill fw-bold py-3 w-100 d-flex justify-content-center align-items-center gap-2 border-0 mt-2">
                    <i class="bi bi-person-plus fs-5"></i>
                    Creer mon compte
                </button>
            {{ form_end(registrationForm) }}
            </div>
        </div>

        <p class="text-center text-white-50 mt-4 small">
            Deja un compte ?
            <a href="{{ path('app_login') }}" class="text-decoration-none link-custom fw-medium ms-1">Se connecter</a>
        </p>
    </div>
</section>
{% endblock %}

{% block javascript %}
    {{ parent() }}
    <script src="{{ asset('js/register.js') }}"></script>
    <script>
    function togglePassword(inputId, btn) {
        const input = document.getElementById(inputId);
        const isText = input.type === 'text';
        input.type = isText ? 'password' : 'text';
        btn.innerHTML = isText ? '<i class="bi bi-eye"></i>' : '<i class="bi bi-eye-slash"></i>';
    }
    </script>
{% endblock %}
