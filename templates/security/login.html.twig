{% extends 'base.html.twig' %}

{% block title %}Connexion | EcoRide{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .custom-pill {
            background-color: rgba(124, 219, 130, 0.1) !important;
            color: #7cdb82 !important;
            border: 1px solid rgba(124, 219, 130, 0.2) !important;
            font-size: 0.75rem !important;
            letter-spacing: 0.05em;
        }
        .custom-input {
            background: #181c21 !important;
            border: 1px solid #32353b !important;
            color: #e0e2ea !important;
            transition: all 0.18s ease;
        }
        .custom-input:focus {
            border-color: rgba(124,219,130,0.5) !important;
            box-shadow: 0 0 0 3px rgba(124, 219, 130, 0.1) !important;
        }
        .custom-input::placeholder {
            color: #5a6458 !important;
        }
        .btn-primary-custom {
            background: linear-gradient(135deg, #7adf7e, #86e683);
            color: #00390f !important;
            box-shadow: 0 10px 28px rgba(124, 219, 130, 0.25);
            transition: all 0.2s ease;
        }
        .btn-primary-custom:hover {
            background: linear-gradient(135deg, #86e683, #97f08f);
            transform: translateY(-1px);
        }
        .link-custom {
            color: #7cdb82;
            transition: color 0.2s ease;
        }
        .link-custom:hover {
            color: #97f08f;
        }
        .btn-toggle-password {
            transition: color 0.2s ease;
        }
        .btn-toggle-password:hover {
            color: #7cdb82 !important;
        }
    </style>
{% endblock %}

{% block body %}
<section class="d-flex align-items-center justify-content-center min-vh-100 py-5" style="background-color: #0b0e14;" data-bs-theme="dark">
    <div class="w-100 px-3" style="max-width: 480px;">
        <div class="text-center mb-5">
            <span class="badge rounded-pill custom-pill text-uppercase px-3 py-2 mb-3 fw-bold">Bon retour parmi nous</span>
            <h1 class="fw-bold text-white mb-3" style="font-size: clamp(1.8rem, 4vw, 2.5rem); letter-spacing: -0.02em;">Se connecter</h1>
            <p class="text-white-50 fs-6 mb-0 lh-lg">Accédez à votre espace EcoRide et reprenez vos trajets en quelques secondes.</p>
        </div>

        {% if error %}
            <div class="alert alert-danger d-flex align-items-center gap-3 rounded-4 border border-danger border-opacity-25" style="background: rgba(220, 53, 69, 0.1); color: #ea868f;">
                <i class="bi bi-exclamation-circle fs-5"></i>
                <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            </div>
        {% endif %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger d-flex align-items-center gap-3 rounded-4 border border-danger border-opacity-25" style="background: rgba(220, 53, 69, 0.1); color: #ea868f;">
                <i class="bi bi-exclamation-circle fs-5"></i>
                <div>{{ message }}</div>
            </div>
        {% endfor %}

        {% for message in app.flashes('success') %}
            <div class="alert alert-success d-flex align-items-center gap-3 rounded-4 border border-success border-opacity-25" style="background: rgba(25, 135, 84, 0.1); color: #7cdb82;">
                <i class="bi bi-check-circle fs-5"></i>
                <div>{{ message }}</div>
            </div>
        {% endfor %}

        <div class="card bg-transparent border-0 rounded-5 shadow-lg w-100" style="background: #1c2025 !important; border: 1px solid #32353b !important;">
            <div class="card-body p-4 p-lg-5">
                <form method="post" action="{{ path('app_login') }}" class="d-flex flex-column gap-4">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}" />

                    <div class="d-flex flex-column gap-2">
                        <label class="form-label text-uppercase fw-bold mb-0 ps-1" for="inputEmail" style="font-size: 0.7rem; color: #9aa49a; letter-spacing: 0.08em;">Email</label>
                        <div class="position-relative">
                            <i class="bi bi-envelope position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                            <input
                                type="email"
                                id="inputEmail"
                                name="email"
                                class="form-control custom-input px-3 py-3 rounded-3 shadow-none"
                                style="padding-left: 2.75rem !important;"
                                placeholder="votre@email.com"
                                autocomplete="email"
                                value="{{ last_username }}"
                                required
                            />
                        </div>
                    </div>

                    <div class="d-flex flex-column gap-2">
                        <label class="form-label text-uppercase fw-bold mb-0 ps-1" for="inputPassword" style="font-size: 0.7rem; color: #9aa49a; letter-spacing: 0.08em;">Mot de passe</label>
                        <div class="position-relative">
                            <i class="bi bi-lock position-absolute top-50 start-0 translate-middle-y ms-3 text-white-50"></i>
                            <input
                                type="password"
                                id="inputPassword"
                                name="password"
                                class="form-control custom-input px-3 py-3 rounded-3 shadow-none"
                                style="padding-left: 2.75rem !important; padding-right: 2.75rem !important;"
                                placeholder="••••••••"
                                autocomplete="current-password"
                                required
                            />
                            <button type="button" onclick="togglePassword('inputPassword', this)" class="btn position-absolute top-50 end-0 translate-middle-y me-1 text-white-50 border-0 shadow-none btn-toggle-password" aria-label="Afficher le mot de passe">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-1 mb-2">
                        <div class="form-check mb-0">
                            <input class="form-check-input shadow-none" type="checkbox" name="_remember_me" id="rememberMe" style="cursor: pointer;" />
                            <label class="form-check-label text-white-50 small mt-1 ms-1" for="rememberMe" style="cursor: pointer;">Se souvenir de moi</label>
                        </div>
                        <a href="#" class="text-decoration-none link-custom small fw-medium">Mot de passe oublie ?</a>
                    </div>

                    <button type="submit" class="btn btn-primary-custom rounded-pill fw-bold py-3 w-100 d-flex justify-content-center align-items-center gap-2 border-0">
                        <i class="bi bi-box-arrow-in-right fs-5"></i>
                        Se connecter
                    </button>
                </form>
            </div>
        </div>

        <p class="text-center text-white-50 mt-4 small">
            Pas encore de compte ?
            <a href="{{ path('app_register') }}" class="text-decoration-none link-custom fw-medium ms-1">Creer un compte</a>
        </p>
    </div>
</section>

<script>
function togglePassword(inputId, btn) {
    const input = document.getElementById(inputId);
    const isText = input.type === 'text';
    input.type = isText ? 'password' : 'text';
    btn.innerHTML = isText ? '<i class="bi bi-eye"></i>' : '<i class="bi bi-eye-slash"></i>';
}
</script>
{% endblock %}
