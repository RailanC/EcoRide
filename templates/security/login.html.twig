{% extends 'base.html.twig' %}

{% block title %}Connexion — EcoRide{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5">

            {# Header #}
            <div class="text-center mb-4">
                <p class="search-eyebrow mb-1">Bon retour parmi nous</p>
                <h1 class="fw-bold" style="font-family: 'Sora', sans-serif; font-size: 2rem; letter-spacing: -0.02em;">
                    Se connecter
                </h1>
                <p class="mt-2" style="color: var(--text-muted); font-size: 0.92rem;">
                    Accédez à votre espace EcoRide
                </p>
            </div>

            {# Authentication error #}
            {% if error %}
                <div class="mb-3 px-3 py-2 rounded-3 d-flex align-items-center gap-2"
                     style="background: rgba(220,53,69,0.12); border: 1px solid rgba(220,53,69,0.25); color: #f28b82; font-size: 0.88rem;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {# Flash messages #}
            {% for message in app.flashes('error') %}
                <div class="mb-3 px-3 py-2 rounded-3 d-flex align-items-center gap-2"
                     style="background: rgba(220,53,69,0.12); border: 1px solid rgba(220,53,69,0.25); color: #f28b82; font-size: 0.88rem;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    {{ message }}
                </div>
            {% endfor %}

            {% for message in app.flashes('success') %}
                <div class="mb-3 px-3 py-2 rounded-3 d-flex align-items-center gap-2"
                     style="background: var(--accent-soft); border: 1px solid rgba(94,188,103,0.22); color: var(--vert); font-size: 0.88rem;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                    {{ message }}
                </div>
            {% endfor %}

            {# Card #}
            <div class="contact-card">

                <form method="post" action="{{ path('app_login') }}">

                    {# CSRF Token #}
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}" />
                    
                    {# Email #}
                    <div class="contact-field mb-3">
                        <label class="contact-label" for="inputEmail">Email</label>
                        <div class="position-relative">
                            <span class="position-absolute d-flex align-items-center"
                                  style="left: 0.85rem; top: 50%; transform: translateY(-50%); color: var(--vert); pointer-events: none;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
                                </svg>
                            </span>
                            <input type="email"
                                id="inputEmail"
                                name="email"
                                class="form-control contact-input"
                                placeholder="votre@email.com"
                                autocomplete="email"
                                value="{{ last_username }}"
                                required
                                style="padding-left: 2.5rem;" />
                        </div>
                    </div>

                    {# Password #}
                    <div class="contact-field mb-3">
                        <label class="contact-label" for="inputPassword">Mot de passe</label>
                        <div class="position-relative">
                            <span class="position-absolute d-flex align-items-center"
                                  style="left: 0.85rem; top: 50%; transform: translateY(-50%); color: var(--vert); pointer-events: none;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                </svg>
                            </span>
                            <input type="password"
                                id="inputPassword"
                                name="password"
                                class="form-control contact-input"
                                placeholder="••••••••"
                                autocomplete="current-password"
                                required
                                style="padding-left: 2.5rem; padding-right: 2.75rem;" />
                            {# Toggle visibility #}
                            <button type="button"
                                    onclick="togglePassword('inputPassword', this)"
                                    class="position-absolute border-0 bg-transparent d-flex align-items-center p-0"
                                    style="right: 0.85rem; top: 50%; transform: translateY(-50%); color: var(--text-muted); cursor: pointer;">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    {# Remember me + Forgot password #}
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="_remember_me" id="rememberMe" />
                            <label class="form-check-label" for="rememberMe" style="font-size: 0.85rem;">
                                Se souvenir de moi
                            </label>
                        </div>
                        <a href="{#{{ path('app_forgot_password') }}#}"
                           style="font-size: 0.85rem; color: var(--lime); text-decoration: none;"
                           onmouseover="this.style.textDecoration='underline'"
                           onmouseout="this.style.textDecoration='none'">
                            Mot de passe oublié ?
                        </a>
                    </div>

                    {# Submit #}
                    <div class="text-center">
                        <button type="submit" class="btn btn-vert px-5 rounded-pill fw-semibold w-100" style="padding-top: 0.75rem; padding-bottom: 0.75rem;" data-turbo="false">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="me-2">
                                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/>
                            </svg>
                            Se connecter
                        </button>
                    </div>

                </form>

            </div>

            {# Divider + Register link #}
            <div class="text-center mt-4" style="font-size: 0.88rem; color: var(--text-muted);">
                Pas encore de compte ?
                <a href="{{ path('app_register') }}"
                   style="color: var(--lime); text-decoration: none; font-weight: 600;"
                   onmouseover="this.style.textDecoration='underline'"
                   onmouseout="this.style.textDecoration='none'">
                    Créer un compte
                </a>
            </div>

        </div>
    </div>
</div>

<script>
function togglePassword(inputId, btn) {
    const input = document.getElementById(inputId);
    const isText = input.type === 'text';
    input.type = isText ? 'password' : 'text';
    btn.innerHTML = isText
        ? `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`
        : `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>`;
}
</script>
{% endblock %}
