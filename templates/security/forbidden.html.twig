{% extends 'base.html.twig' %}

{% block title %}Acces refuse - EcoRide{% endblock %}

{% block body %}
<div class="container py-5" style="max-width: 920px;">
    <div class="row justify-content-center g-4">
        <div class="col-12 col-lg-8">
            <div class="mb-4">
                <p class="search-eyebrow mb-1">Zone protegee</p>
                <h1 class="fw-bold" style="font-family:'Sora',sans-serif;font-size:2.4rem;letter-spacing:-0.03em;">
                    Acces refuse
                </h1>
                <p style="color:var(--text-muted);font-size:0.98rem;line-height:1.7;max-width:32rem;">
                    Cette page est reservee aux membres autorises. Votre compte ne dispose pas des permissions
                    necessaires pour ouvrir cet espace du tableau de bord.
                </p>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a href="{{ path('app_home') }}" class="btn btn-vert px-4 rounded-pill fw-semibold">
                    Retour a l'accueil
                </a>
                <a href="{{ path('app_profile') }}" class="btn btn-details text-decoration-none px-4 py-2">
                    Aller au profil
                </a>
            </div>
        </div>

        <div class="col-12 col-lg-8">
            <div class="contact-card" style="padding:2rem;">
                <div
                    class="d-inline-flex align-items-center justify-content-center mb-4"
                    style="width:72px;height:72px;border-radius:20px;background:rgba(220,53,69,.12);border:1px solid rgba(220,53,69,.22);color:#f28b82;"
                >
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2L4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3z"/>
                        <path d="M9.2 9a3 3 0 1 1 5.6 1.5c-.4.7-1 1.2-1.6 1.7-.8.6-1.2 1-1.2 1.8"/>
                        <path d="M12 17h.01"/>
                    </svg>
                </div>

                <h2 class="contact-title mb-3" style="font-size:1.05rem;text-align:left;">Pourquoi cette page apparait ?</h2>

                <div class="d-flex flex-column gap-3">
                    <div style="border:1px solid rgba(255,255,255,.08);border-radius:var(--radius-sm);padding:1rem;">
                        <p class="fw-semibold mb-1" style="font-family:'Sora',sans-serif;font-size:.92rem;">Acces limite par role</p>
                        <p class="mb-0" style="color:var(--text-muted);font-size:.9rem;">
                            Cette section est protegee par les regles de securite Symfony et n est pas accessible a tous les comptes.
                        </p>
                    </div>

                    <div style="border:1px solid rgba(255,255,255,.08);border-radius:var(--radius-sm);padding:1rem;">
                        <p class="fw-semibold mb-1" style="font-family:'Sora',sans-serif;font-size:.92rem;">Que faire maintenant ?</p>
                        <p class="mb-0" style="color:var(--text-muted);font-size:.9rem;">
                            Revenez a l accueil, consultez votre profil, ou connectez-vous avec un compte qui dispose du role attendu.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
