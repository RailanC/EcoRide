{% extends 'base.html.twig' %}

{% block title %}EcoRide | Conduire en groupe est bien mieux{% endblock %}

{% block body %}

{# ── HERO ─────────────────────────────────────────────────────────── #}
<section class="position-relative d-flex flex-column justify-content-center align-items-center w-100 overflow-hidden" id="hero-section" style="min-height: 100vh; padding-top: 8rem; padding-bottom: 4rem;">

    <div class="position-absolute top-0 start-0 w-100 h-100 z-n1">
        <img src="{{ asset('images/van-hero.png') }}" alt="EcoRide – véhicule électrique en route" class="w-100 h-100 object-fit-cover" style="opacity: 0.35;" />
        <div class="position-absolute top-0 start-0 w-100 h-100 hero-bg-overlay"></div>
    </div>

    <div class="position-relative z-1 d-flex flex-column align-items-center text-center gap-4 w-100 px-3" style="max-width: 1600px;">

        <h1 class="display-3 fw-bold text-white lh-sm mb-0" style="letter-spacing: -0.03em;">
            Conduire en groupe est<br>
            <span class="text-gradient-custom">bien mieux.</span>
        </h1>

        <p class="fs-5 text-white-50 mb-0" style="max-width: 1000px; line-height: 1.7;">
            Rejoignez l'élite de la mobilité durable. Partagez vos trajets dans des
            véhicules électriques premium et réduisez votre empreinte carbone sans
            compromis sur le confort.
        </p>

        <div class="w-100 mt-4" style="max-width: 1400px;">
            <div class="mb-4 d-flex justify-content-start ">
                <div class="btn-group p-1 rounded-pill" style="background: rgba(31, 35, 41, 0.9); border: 1px solid rgba(255,255,255,0.06); box-shadow: 0 12px 30px rgba(0,0,0,0.22);" role="group" aria-label="Type de trajet" data-trip-toggle-group>
                    <button type="button" class="btn rounded-pill px-4 py-2 fw-medium text-white border-0 btn-search-custom" style="min-width: 160px;" onclick="setTrip(this, false)" data-trip-toggle-option aria-pressed="true">Aller simple</button>
                    <button type="button" class="btn rounded-pill px-4 py-2 fw-medium text-white-50 border-0" style="background: #23272d; min-width: 160px;" onclick="setTrip(this, true)" data-trip-toggle-option aria-pressed="false">Aller-retour</button>
                </div>
            </div>

            <div class="search-pillar-bg rounded-pill shadow-lg overflow-hidden position-relative" data-bs-theme="dark">
                <form method="get" action="{{ path('app_covoiturage') }}" class="d-flex flex-column flex-lg-row align-items-stretch p-2" style="min-height: 72px;">
                    
                    <div class="d-flex flex-column flex-lg-row flex-grow-1 bg-white bg-opacity-10 rounded-pill overflow-hidden">
                        
                        <div class="search-field-custom flex-fill d-flex flex-column justify-content-center px-3 py-2">
                            <label for="from" class="form-label text-uppercase fw-bold mb-1" style="font-size: 0.68rem; color: #9aa49a; letter-spacing: 0.08em;">Départ</label>
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-geo-alt fs-5" style="color: #5a6458;"></i>
                                <input type="text" name="departure" id="from" placeholder="Ville ou aéroport" autocomplete="off" class="form-control bg-transparent border-0 shadow-none p-0 text-white fw-medium" />
                            </div>
                        </div>

                        <div class="d-none d-lg-flex flex-column align-items-center justify-content-center position-relative z-2 mx-n3" style="width: 0;">
                            <button type="button" class="swap-btn-custom rounded-circle d-flex align-items-center justify-content-center position-absolute" onclick="swapCities()" title="Inverser départ / destination" aria-label="Inverser départ et destination">
                                <i class="bi bi-arrow-left-right"></i>
                            </button>
                        </div>

                        <div class="search-field-custom flex-fill d-flex flex-column justify-content-center px-3 py-2 ps-lg-5">
                            <label for="to" class="form-label text-uppercase fw-bold mb-1" style="font-size: 0.68rem; color: #9aa49a; letter-spacing: 0.08em;">Destination</label>
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-flag fs-5" style="color: #5a6458;"></i>
                                <input type="text" name="arrival" id="to" placeholder="Ville ou aéroport" autocomplete="off" class="form-control bg-transparent border-0 shadow-none p-0 text-white fw-medium" />
                            </div>
                        </div>

                        <div class="search-field-custom flex-fill d-flex flex-column justify-content-center px-3 py-2">
                            <label for="departure-date" class="form-label text-uppercase fw-bold mb-1" style="font-size: 0.68rem; color: #9aa49a; letter-spacing: 0.08em;">Date</label>
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-calendar4 fs-5" style="color: #5a6458;"></i>
                                <input type="date" name="date" id="departure-date" class="form-control bg-transparent border-0 shadow-none p-0 text-white fw-medium" value="{{ 'now'|date('Y-m-d') }}" />
                            </div>
                        </div>

                        <div class="search-field-custom flex-fill d-flex flex-column justify-content-center px-3 py-2 d-none" id="return-field">
                            <label for="return-date" class="form-label text-uppercase fw-bold mb-1" style="font-size: 0.68rem; color: #9aa49a; letter-spacing: 0.08em;">Retour</label>
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-calendar2-event fs-5" style="color: #5a6458;"></i>
                                <input type="date" name="return_date" id="return-date" class="form-control bg-transparent border-0 shadow-none p-0 text-white fw-medium" disabled />
                            </div>
                        </div>

                        <div class="search-field-custom flex-fill d-flex flex-column justify-content-center px-3 py-2 border-0">
                            <label for="passengers" class="form-label text-uppercase fw-bold mb-1" style="font-size: 0.68rem; color: #9aa49a; letter-spacing: 0.08em;">Voyageurs</label>
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-person fs-5" style="color: #5a6458;"></i>
                                <select name="passengers" id="passengers" class="form-select bg-transparent border-0 shadow-none p-0 text-white fw-medium" style="appearance: none; -webkit-appearance: none;">
                                    <option value="1" class="text-dark">1 passager</option>
                                    <option value="2" class="text-dark">2 passagers</option>
                                    <option value="3" class="text-dark">3 passagers</option>
                                    <option value="4" class="text-dark">4 passagers</option>
                                    <option value="5" class="text-dark">5+ passagers</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="ps-lg-2 pt-2 pt-lg-0 mt-2 mt-lg-0 d-flex flex-column justify-content-stretch">
                        <button type="submit" class="btn btn-search-custom rounded-pill fw-bold h-100 d-flex align-items-center justify-content-center px-4 fs-6 border-0">
                            Rechercher
                            <i class="bi bi-search ms-2"></i>
                        </button>
                    </div>

                </form>
            </div>
        </div>

    </div>

    <div class="position-absolute bottom-0 start-50 translate-middle-x mb-4 text-center text-white-50 opacity-75 animate-bounce-custom z-1 d-flex flex-column align-items-center gap-1">
        <span class="text-uppercase fw-bold" style="font-size: 0.7rem; letter-spacing: 0.1em;">Découvrir</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>
    </div>

</section>

{# ── FLEET ────────────────────────────────────────────────────────── #}
<section class="py-5" id="feature-fleet" style="background-color: #101419;">
    <div class="container py-5" style="max-width: 1600px;">
        <div class="row align-items-center gx-lg-5 gy-5">

            <div class="col-lg-6">
                <div class="position-relative rounded-5 overflow-hidden shadow-lg" style="border: 1px solid #32353b; height: 480px;">
                    <img src="{{ asset('images/van-side.png') }}" alt="Intérieur véhicule électrique premium EcoRide" class="w-100 h-100 object-fit-cover" />
                    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(to top, rgba(16,20,25,0.9) 0%, transparent 50%); pointer-events: none;"></div>
                    
                    <div class="position-absolute bottom-0 start-0 w-100 p-4 z-1">
                        <div class="d-flex align-items-center justify-content-between rounded-4 p-3" style="background: rgba(16,20,25,0.75); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.07);">
                            <div>
                                <h4 class="text-white fs-5 fw-bold mb-1">Classe Executive</h4>
                                <p class="text-white-50 small mb-0">Zéro émission, confort maximal.</p>
                            </div>
                            <span class="badge custom-badge-lime rounded-pill py-2 px-3 fw-bold text-uppercase">100 % EV</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 d-flex flex-column gap-3">
                <div>
                    <span class="badge custom-pill rounded-pill d-inline-flex align-items-center text-uppercase px-3 py-2 mb-3 fw-bold">
                        <svg class="me-2" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                        Flotte Électrique
                    </span>
                    <h2 class="fw-bold text-white mb-3" style="font-size: clamp(1.7rem, 4vw, 2.4rem); letter-spacing: -0.02em;">Une expérience de voyage sans compromis.</h2>
                    <p class="text-white-50 fs-5 lh-lg mb-0">
                        Notre flotte exclusivement composée de véhicules électriques haut de gamme
                        garantit un trajet silencieux, fluide et respectueux de l'environnement.
                        Partagez l'espace, pas les émissions.
                    </p>
                </div>

                <ul class="list-unstyled d-flex flex-column gap-3 mb-0 mt-3">
                    <li class="d-flex align-items-start gap-3 p-4 rounded-4" style="background: #272a30; border: 1px solid #32353b;">
                        <div class="d-flex align-items-center justify-content-center rounded-3 flex-shrink-0" style="width: 44px; height: 44px; background: #181c21; border: 1px solid rgba(255,255,255,0.07); color: #7cdb82;">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        </div>
                        <div>
                            <strong class="d-block text-white fs-6 fw-bold mb-1">Confort Premium</strong>
                            <p class="text-white-50 small mb-0">Sièges ergonomiques et espace optimisé.</p>
                        </div>
                    </li>
                    <li class="d-flex align-items-start gap-3 p-4 rounded-4" style="background: #272a30; border: 1px solid #32353b;">
                        <div class="d-flex align-items-center justify-content-center rounded-3 flex-shrink-0" style="width: 44px; height: 44px; background: #181c21; border: 1px solid rgba(255,255,255,0.07); color: #7cdb82;">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                        </div>
                        <div>
                            <strong class="d-block text-white fs-6 fw-bold mb-1">Sécurité Vérifiée</strong>
                            <p class="text-white-50 small mb-0">Chauffeurs professionnels et certifiés.</p>
                        </div>
                    </li>
                </ul>
            </div>

    </div>
</section>

{# ── IMPACT BENTO ─────────────────────────────────────────────────── #}
<section class="py-5" id="feature-impact" style="background-color: #0b0e14;">
    <div class="container py-5" style="max-width: 1600px;">

        <div class="text-center mx-auto mb-5" style="max-width: 700px;">
            <h2 class="fw-bold text-white mb-3" style="font-size: clamp(1.7rem, 4vw, 2.4rem); letter-spacing: -0.02em;">L'impact de notre communauté</h2>
            <p class="text-white-50 fs-5 lh-lg mb-0">
                Chaque trajet partagé contribue directement à la préservation de nos
                écosystèmes. Voici ce que nous avons accompli ensemble cette année.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-md-8">
                <div class="bento-card-bg bento-glow rounded-5 p-4 p-lg-5 position-relative overflow-hidden d-flex flex-column h-100">
                    <div class="bento-icon rounded-3 d-flex align-items-center justify-content-center mb-3 flex-shrink-0">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 16.5C17 19 14.76 21 12 21S7 19 7 16.5c0-2 2-4.5 5-8 3 3.5 5 6 5 8z"/><path d="M12 13V3"/><path d="M9 6l3-3 3 3"/></svg>
                    </div>
                    <div class="fw-bold text-white lh-1 mb-1" style="font-size: 3.5rem; letter-spacing: -0.04em;">2.4<span style="font-size: 2rem; color: #7cdb82;">M</span></div>
                    <strong class="text-white fs-6 fw-bold mt-1">Tonnes de CO₂ évitées</strong>
                    <p class="text-white-50 small mt-2 mb-0 lh-lg">Équivalent à la plantation de 100 000 arbres dans des zones déforestées.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="bento-card-bg rounded-5 p-4 p-lg-5 d-flex flex-column h-100">
                    <div class="bento-icon orange rounded-3 d-flex align-items-center justify-content-center mb-3 flex-shrink-0">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </div>
                    <div class="fw-bold text-white lh-1 mb-1" style="font-size: 3.5rem; letter-spacing: -0.04em;">50k+</div>
                    <strong class="text-white fs-6 fw-bold mt-1">Membres Actifs</strong>
                    <p class="text-white-50 small mt-2 mb-0 lh-lg">Une communauté engagée pour une mobilité responsable.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="bento-card-bg rounded-5 p-4 p-lg-5 d-flex flex-column h-100">
                    <div class="bento-icon rounded-3 d-flex align-items-center justify-content-center mb-3 flex-shrink-0">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 17 9 11 13 15 21 7"/><polyline points="14 7 21 7 21 14"/></svg>
                    </div>
                    <div class="fw-bold text-white lh-1 mb-1" style="font-size: 3.5rem; letter-spacing: -0.04em;">12M</div>
                    <strong class="text-white fs-6 fw-bold mt-1">Kilomètres partagés</strong>
                    <p class="text-white-50 small mt-2 mb-0 lh-lg">Chaque kilomètre partagé est un geste pour la planète.</p>
                </div>
            </div>

            <div class="col-md-8">
                <div class="rounded-5 overflow-hidden position-relative h-100 d-flex flex-column justify-content-center p-4 p-lg-5" style="min-height: 300px; border: 1px solid #32353b;">
                    <img src="{{ asset('images/van-hero.png') }}" alt="Forêt EcoRide" class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover z-0" />
                    <div class="position-absolute top-0 start-0 w-100 h-100 z-0" style="background: linear-gradient(to right, rgba(11,14,20,0.92) 0%, rgba(11,14,20,0.4) 100%);"></div>
                    
                    <div class="position-relative z-1 d-flex flex-column justify-content-center h-100" style="max-width: 420px; gap: 0.75rem;">
                        <h3 class="text-white fw-bold" style="font-size: 1.4rem;">Initiative Forêt EcoRide</h3>
                        <p class="text-white-75 mb-2 lh-lg" style="font-size: 0.9rem;">Pour chaque 100 km parcourus, nous reversons 1 % à des projets de reforestation locaux certifiés.</p>
                        <div>
                            <button type="button" class="btn rounded-pill px-4 py-2 text-white fw-medium border" style="background: transparent; border-color: rgba(255,255,255,0.2);">Découvrir le projet</button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

{# ── CONTACT ──────────────────────────────────────────────────────── #}
<section class="py-5" id="contact-section" style="background-color: #181c21;">
    <div class="container py-5" style="max-width: 1600px;">
        <div class="card bg-transparent border-0 rounded-5 shadow-lg mx-auto" style="max-width: 820px; background: #1c2025 !important; border: 1px solid #32353b !important;">
            <div class="card-body p-4 p-lg-5">

                <div class="text-center mb-5">
                    <div class="mx-auto rounded-4 d-flex align-items-center justify-content-center mb-4" style="width: 64px; height: 64px; background: rgba(124, 219, 130, 0.1); border: 1px solid rgba(124, 219, 130, 0.2); color: #7cdb82;">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    </div>
                    <h2 class="fw-bold text-white mb-2" style="font-size: clamp(1.7rem, 4vw, 2.4rem); letter-spacing: -0.02em;">Restons en contact</h2>
                    <p class="text-white-50 fs-5 mb-0">Une question sur nos services entreprises ou notre charte écologique ?</p>
                </div>

                <form action="{{ path('app_contact') }}" method="post" class="d-flex flex-column gap-4">
                    <div class="row g-4">
                        <div class="col-md-6 d-flex flex-column gap-2">
                            <label class="form-label text-uppercase fw-bold mb-0 ps-1" for="contact-name" style="font-size: 0.7rem; color: #9aa49a; letter-spacing: 0.08em;">Nom complet</label>
                            <input type="text" id="contact-name" name="name" class="form-control custom-input px-3 py-2 rounded-3 shadow-none" placeholder="Jean Dupont" />
                        </div>
                        <div class="col-md-6 d-flex flex-column gap-2">
                            <label class="form-label text-uppercase fw-bold mb-0 ps-1" for="contact-email" style="font-size: 0.7rem; color: #9aa49a; letter-spacing: 0.08em;">Email professionnel</label>
                            <input type="email" id="contact-email" name="email" class="form-control custom-input px-3 py-2 rounded-3 shadow-none" placeholder="jean@entreprise.com" />
                        </div>
                    </div>

                    <div class="d-flex flex-column gap-2">
                        <label class="form-label text-uppercase fw-bold mb-0 ps-1" for="contact-message" style="font-size: 0.7rem; color: #9aa49a; letter-spacing: 0.08em;">Message</label>
                        <textarea id="contact-message" name="message" class="form-control custom-input px-3 py-2 rounded-3 shadow-none" rows="5" placeholder="Comment pouvons-nous collaborer ?" style="resize: vertical;"></textarea>
                    </div>

                    <div class="d-flex justify-content-end mt-2">
                        <button type="submit" class="btn btn-search-custom rounded-pill fw-bold px-4 py-3 d-flex align-items-center gap-2 border-0">
                            Envoyer le message
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

{% endblock %}
