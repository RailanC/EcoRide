{% extends 'base.html.twig' %}

{% block title %}Dashboard - EcoRide{% endblock %}

{% block body %}
<div class="container py-5" style="max-width: 1080px;">
    <div class="mb-4">
        <p class="search-eyebrow mb-1">Espace de supervision</p>
        <h1 class="fw-bold" style="font-family:'Sora',sans-serif;font-size:2.1rem;letter-spacing:-0.02em;">
            Dashboard
        </h1>
        <p style="color:var(--text-muted);font-size:0.94rem;">
            Suivez l activite de la plateforme et accedez rapidement aux zones de moderation.
        </p>
    </div>

    <div class="contact-card mb-4" style="padding:1.4rem 1.5rem;">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <p class="mb-1 fw-semibold" style="font-family:'Sora',sans-serif;font-size:1rem;">Bienvenue dans votre espace equipe</p>
                <p class="mb-0" style="color:var(--text-muted);font-size:.9rem;">
                    Utilisateur connecte:
                    <span style="color:var(--text);font-weight:600;">{{ app.user ? app.user.username : 'Inconnu' }}</span>
                </p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a href="{{ path('app_home') }}" class="btn btn-details text-decoration-none px-3 py-2">Accueil</a>
                <a href="{{ path('app_profile') }}" class="btn btn-details text-decoration-none px-3 py-2">Profil</a>
                <a href="{{ path('app_profile_trips') }}" class="btn btn-vert px-3 py-2">Mes trajets</a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-4">
            <div class="contact-card h-100">
                <div
                    class="d-inline-flex align-items-center justify-content-center mb-3"
                    style="width:52px;height:52px;border-radius:14px;background:rgba(94,188,103,.12);border:1px solid rgba(94,188,103,.25);"
                >
                    <i class="bi bi-chat-square-text fs-5" style="color:var(--lime);"></i>
                </div>
                <h2 class="contact-title mb-2" style="text-align:left;font-size:1.02rem;">Regarder tous les avis</h2>
                <p style="color:var(--text-muted);font-size:.88rem;line-height:1.6;">
                    Accedez a la liste complete des avis utilisateurs pour monitorer la satisfaction et identifier les tendances.
                </p>
                <div class="mt-3">
                    <a href="{{ path('app_reviews') }}" class="btn-details text-decoration-none">Voir les avis en attente</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="contact-card h-100">
                <div
                    class="d-inline-flex align-items-center justify-content-center mb-3"
                    style="width:52px;height:52px;border-radius:14px;background:rgba(167,217,48,.12);border:1px solid rgba(167,217,48,.25);"
                >
                    <i class="bi bi-exclamation-triangle fs-5" style="color:var(--lime);"></i>
                </div>
                <h2 class="contact-title mb-2" style="text-align:left;font-size:1.02rem;">Regarder les signalements</h2>
                <p style="color:var(--text-muted);font-size:.88rem;line-height:1.6;">
                    Consultez les signalements de trajets pour identifier les problemes critiques et assurer la securite de la communaute.
                </p>
                <div class="mt-3">
                    <a href="{{ path('app_reports') }}" class="btn-details text-decoration-none">Voir les signalements</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="contact-card h-100">
                <div
                    class="d-inline-flex align-items-center justify-content-center mb-3"
                    style="width:52px;height:52px;border-radius:14px;background:rgba(123,68,37,.18);border:1px solid rgba(123,68,37,.32);"
                >
                    <i class="bi bi-shield-check fs-5" style="color:#e6c7a2;"></i>
                </div>
                <h2 class="contact-title mb-2" style="text-align:left;font-size:1.02rem;">Administration</h2>
                <p style="color:var(--text-muted);font-size:.88rem;line-height:1.6;">
                    Accedez aux controles avances et aux parametres techniques de la plateforme.
                </p>
                <div class="mt-3">
                    {% if is_granted('ROLE_ADMIN') %}
                        <span class="badge-eco">Acces admin actif</span>
                        <div class="mt-3">
                            <a href="{{ path('app_dashboard_admin') }}" class="btn-details text-decoration-none">Voir la page admin</a>
                        </div>
                    {% else %}
                        <span class="btn-details">Reserve admin</span>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="contact-card mt-4">
        <h2 class="contact-title mb-3" style="text-align:left;font-size:1rem;">Prochaines zones a connecter</h2>
        <div class="row g-3">
            <div class="col-12 col-md-6" id="signalements">
                <div style="border:1px solid rgba(255,255,255,.08);border-radius:var(--radius-sm);padding:1rem;">
                    <p class="mb-1 fw-semibold" style="font-family:'Sora',sans-serif;font-size:.9rem;">Liste des avis en attente</p>
                    {% if pendingReviews is empty %}
                        <p class="mb-0" style="color:var(--text-muted);">Aucun avis en attente.</p>
                    {% else %}
                        <div class="d-flex flex-column gap-3">
                            {% for review in pendingReviews %}
                                <div style="border:1px solid rgba(255,255,255,.08);border-radius:var(--radius-sm);padding:1rem;">
                                    <div class="fw-semibold">{{ review.trip.departureLocation }} &rarr; {{ review.trip.arrivalLocation }}</div>
                                    <div style="font-size:.82rem;color:var(--text-muted);">
                                        Auteur: {{ review.author.username }} | Conducteur: {{ review.user.username }} | Note: {{ review.rating }}/5
                                    </div>
                                    <p class="mt-3 mb-3">{{ review.comment }}</p>
                                    <div class="d-flex gap-2 flex-wrap row">
                                        <form method="post" action="{{ path('app_approve_review', {id: review.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('approve_review_' ~ review.id) }}">
                                            <button type="submit" class="btn btn-vert btn-sm">Approuver</button>
                                        </form>
                                        <form method="post" action="{{ path('app_reject_review', {id: review.id}) }}" class="d-flex gap-2 flex-wrap">
                                            <input type="hidden" name="_token" value="{{ csrf_token('reject_review_' ~ review.id) }}">
                                            <textarea type="text" name="moderation_note" class="form-control contact-input form-control-sm" placeholder="Motif du rejet" style="max-width:240px;"></textarea>
                                            <button type="submit" class="btn btn-outline-danger btn-sm">Rejeter</button>
                                        </form>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div style="border:1px solid rgba(255,255,255,.08);border-radius:var(--radius-sm);padding:1rem;">
                    <p class="mb-1 fw-semibold" style="font-family:'Sora',sans-serif;font-size:.9rem;">Signalements de trajet</p>
                    {% if pendingIssues is empty %}
                        <p class="mb-0" style="color:var(--text-muted);">Aucun signalement en attente.</p>
                    {% else %}
                        <div class="d-flex flex-column gap-3">
                            {% for issue in pendingIssues %}
                                <div style="border:1px solid rgba(255,255,255,.08);border-radius:var(--radius-sm);padding:1rem;">
                                    <div class="fw-semibold">{{ issue.trip.departureLocation }} &rarr; {{ issue.trip.arrivalLocation }}</div>
                                    <div style="font-size:.82rem;color:var(--text-muted);">
                                        Auteur: {{ issue.participant.username }} | Conducteur: {{ issue.driver.username }} | Statut: {{ issue.status }}
                                    </div>
                                    <p class="mt-3 mb-3">{{ issue.comment }}</p>
                                    <div class="d-flex gap-2 flex-wrap row">
                                        <a href="{{ path('app_report', {id: issue.id}) }}" class="btn btn-vert btn-sm text-decoration-none">Voir le detail</a>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
