{% extends 'base.html.twig' %}

{% block title %}Avis - Dashboard{% endblock %}

{% block body %}
<div class="container py-5" style="max-width: 1080px;">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <p class="search-eyebrow mb-1">Espace de supervision</p>
            <h1 class="fw-bold mb-1" style="font-family:'Sora',sans-serif;font-size:2rem;letter-spacing:-0.02em;">
                Tous les avis
            </h1>
            <p style="color:var(--text-muted);font-size:0.94rem;margin-bottom:0;">
                Consultez l ensemble des avis déposés par les participants.
            </p>
        </div>

        <a href="{{ path('app_dashboard') }}" class="btn btn-outline-light text-decoration-none">Retour au dashboard</a>
    </div>

    <div class="contact-card">
        <div class="section-header mb-4">
            <span class="section-title">Liste des avis</span>
            <span class="results-count">{{ reviews|length }} resultat{{ reviews|length > 1 ? 's' }}</span>
        </div>

        {% if reviews is empty %}
            <div class="empty-state">
                <div class="empty-state-title">Aucun avis</div>
                <p style="font-size:0.95rem;">Il n y a aucun avis pour le moment.</p>
            </div>
        {% else %}
            <div class="d-flex flex-column gap-3">
                {% for review in reviews %}
                    <div style="border:1px solid rgba(255,255,255,.08);border-radius:var(--radius-sm);padding:1rem;">
                        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                            <div>
                                <div class="fw-semibold">
                                    {{ review.trip ? review.trip.departureLocation ~ ' &rarr; ' ~ review.trip.arrivalLocation : 'Trajet supprime' }}
                                </div>
                                <div style="font-size:.82rem;color:var(--text-muted);">
                                    {% if review.trip and review.trip.departureDate and review.trip.departureTime %}
                                        {{ review.trip.departureDate|date('d/m/Y') }} a {{ review.trip.departureTime|date('H:i') }}
                                    {% endif %}
                                </div>
                            </div>

                            <div class="d-flex flex-column align-items-end gap-2">
                                <span class="badge-eco">{{ reviewStatusLabels[review.status]|default(review.status) }}</span>
                                <span class="btn-details">{{ review.rating }}/5</span>
                            </div>
                        </div>

                        <div class="row g-3 mt-2">
                            <div class="col-12 col-md-4">
                                <div class="contact-label">Auteur</div>
                                <div class="fw-semibold">{{ review.author ? review.author.username : 'Utilisateur supprime' }}</div>
                                <div style="color:var(--text-muted);font-size:.9rem;">{{ review.author ? review.author.email : 'Email indisponible' }}</div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="contact-label">Conducteur</div>
                                <div class="fw-semibold">{{ review.user ? review.user.username : 'Utilisateur supprime' }}</div>
                                <div style="color:var(--text-muted);font-size:.9rem;">{{ review.user ? review.user.email : 'Email indisponible' }}</div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="contact-label">Modere par</div>
                                <div class="fw-semibold">{{ review.moderatedBy ? review.moderatedBy.username : 'Non modere' }}</div>
                                <div style="color:var(--text-muted);font-size:.9rem;">
                                    {{ review.moderatedAt ? review.moderatedAt|date('d/m/Y H:i') : 'Aucune date' }}
                                </div>
                            </div>
                        </div>

                        <div class="mt-3">
                            <div class="contact-label">Commentaire</div>
                            <p class="mb-0" style="white-space:pre-wrap;">{{ review.comment }}</p>
                        </div>

                        {% if review.moderationNote %}
                            <div class="mt-3">
                                <div class="contact-label">Note de moderation</div>
                                <p class="mb-0" style="white-space:pre-wrap;">{{ review.moderationNote }}</p>
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
