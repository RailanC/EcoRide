{% extends 'base.html.twig' %}

{% block title %}Signalements - Dashboard{% endblock %}

{% block body %}
<div class="container py-5 mw-1080px">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <p class="small text-muted mb-1">Espace de supervision</p>
            <h1 class="fw-bold mb-1 page-title-custom">
                Tous les signalements
            </h1>
            <p class="text-muted fs-94 mb-0">
                Parcourez l ensemble des covoiturages signalés sur la plateforme.
            </p>
        </div>

        <a href="{{ path('app_dashboard') }}" class="btn btn-outline-secondary text-decoration-none">Retour au dashboard</a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white p-4 d-flex justify-content-between align-items-center rounded-top-4">
            <h2 class="h5 mb-0 fw-bold">Liste des signalements</h2>
            <span class="badge bg-light text-dark border rounded-pill fw-normal fs-6">{{ reports|length }} resultat{{ reports|length > 1 ? 's' }}</span>
        </div>

        <div class="card-body p-4">
            {% if reports is empty %}
                <div class="text-center p-5">
                    <h3 class="h5 fw-bold">Aucun signalement</h3>
                    <p class="text-muted mb-0">Il n y a aucun signalement pour le moment.</p>
                </div>
            {% else %}
                <div class="d-flex flex-column gap-3">
                {% for report in reports %}
                        <div class="bg-light border rounded-3 p-3">
                        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                            <div>
                                <div class="fw-semibold">
                                    #{{ report.trip ? report.trip.id : report.id }}
                                    -
                                    {{ report.trip ? report.trip.departureLocation ~ ' &rarr; ' ~ report.trip.arrivalLocation : 'Trajet supprime' }}
                                </div>
                                <div class="small text-muted">
                                    {% if report.trip and report.trip.departureDate and report.trip.departureTime %}
                                        Depart: {{ report.trip.departureDate|date('d/m/Y') }} a {{ report.trip.departureTime|date('H:i') }}
                                    {% endif %}
                                    {% if report.trip and report.trip.arrivalDate and report.trip.arrivalTime %}
                                        {% if report.trip and report.trip.departureDate and report.trip.departureTime %} | {% endif %}
                                        Arrivee: {{ report.trip.arrivalDate|date('d/m/Y') }} a {{ report.trip.arrivalTime|date('H:i') }}
                                    {% endif %}
                                </div>
                            </div>

                            <div class="d-flex flex-column align-items-end gap-2">
                                <span class="badge rounded-pill text-bg-secondary fw-medium">{{ reportStatusLabels[report.status]|default(report.status) }}</span>
                                <a href="{{ path('app_report', {id: report.id}) }}" class="btn btn-sm btn-outline-secondary text-decoration-none">Voir le detail</a>
                            </div>
                        </div>

                        <div class="row g-3 mt-2">
                            <div class="col-12 col-md-4">
                                <div class="small text-muted">Participant</div>
                                <div class="fw-semibold">{{ report.participant ? report.participant.username : 'Utilisateur supprime' }}</div>
                                <div class="small text-muted">{{ report.participant ? report.participant.email : 'Email indisponible' }}</div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="small text-muted">Conducteur</div>
                                <div class="fw-semibold">{{ report.driver ? report.driver.username : 'Utilisateur supprime' }}</div>
                                <div class="small text-muted">{{ report.driver ? report.driver.email : 'Email indisponible' }}</div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="small text-muted">Signale le</div>
                                <div class="fw-semibold">{{ report.createdAt ? report.createdAt|date('d/m/Y H:i') : 'Non renseigne' }}</div>
                            </div>
                        </div>

                        <div class="mt-3">
                            <div class="small text-muted">Description</div>
                            <p class="mb-0 text-pre-wrap">{{ report.comment }}</p>
                        </div>
                    </div>
                {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
