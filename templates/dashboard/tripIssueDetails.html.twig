{% extends 'base.html.twig' %}

{% block title %}Signalement de trajet{% endblock %}

{% block body %}
<div class="container py-5 mw-980px">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <p class="small text-muted mb-1">Espace de supervision</p>
            <h1 class="fw-bold mb-1 page-title-custom">
                Signalement de trajet
            </h1>
            <p class="text-muted fs-94 mb-0">
                Consultez les details du litige avant de prendre une decision.
            </p>
        </div>

        <a href="{{ path('app_dashboard') }}" class="btn btn-outline-secondary text-decoration-none">Retour au tableau de bord</a>
    </div>

    {% for msg in app.flashes('success') %}
        <div class="alert alert-success rounded-3 shadow-sm">{{ msg }}</div>
    {% endfor %}
    {% for msg in app.flashes('error') %}
        <div class="alert alert-danger rounded-3 shadow-sm">{{ msg }}</div>
    {% endfor %}
    {% for msg in app.flashes('info') %}
        <div class="alert alert-info rounded-3 shadow-sm">{{ msg }}</div>
    {% endfor %}

    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-header bg-white p-4 d-flex justify-content-between align-items-center border-bottom rounded-top-4">
            <h2 class="h5 mb-0 fw-bold">Vue d ensemble</h2>
            <span class="badge rounded-pill text-bg-secondary fw-medium">{{ issueStatusLabels[issue.status]|default(issue.status) }}</span>
        </div>

        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="bg-light border rounded-3 p-3 h-100">
                        <div class="small text-muted mb-1">Trip ID</div>
                        <div class="fw-semibold">{{ issue.trip.id }}</div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="bg-light border rounded-3 p-3 h-100">
                        <div class="small text-muted mb-1">Statut du signalement</div>
                        <div class="fw-semibold">{{ issueStatusLabels[issue.status]|default(issue.status) }}</div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="bg-light border rounded-3 p-3 h-100">
                        <div class="small text-muted mb-1">Date de creation</div>
                        <div class="fw-semibold">{{ issue.createdAt ? issue.createdAt|date('d/m/Y H:i') : 'Non renseignee' }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-7">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-header bg-white p-4 border-bottom rounded-top-4">
                    <h2 class="h5 mb-0 fw-bold">Details du trajet</h2>
                </div>

                <div class="card-body p-4">
                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <div class="bg-light border rounded-3 p-3 h-100">
                                <div class="small text-muted mb-1 text-uppercase fw-bold" style="font-size: 0.8rem;">Depart</div>
                                <div class="fw-bold fs-5 mb-1">{{ issue.trip.departureLocation }}</div>
                                <div class="small text-muted">{{ issue.trip.departureDate|date('d/m/Y') }}</div>
                                <div class="small text-muted">{{ issue.trip.departureTime|date('H:i') }}</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="bg-light border rounded-3 p-3 h-100">
                                <div class="small text-muted mb-1 text-uppercase fw-bold" style="font-size: 0.8rem;">Arrivee</div>
                                <div class="fw-bold fs-5 mb-1">{{ issue.trip.arrivalLocation }}</div>
                                <div class="small text-muted">{{ issue.trip.arrivalDate|date('d/m/Y') }}</div>
                                <div class="small text-muted">{{ issue.trip.arrivalTime|date('H:i') }}</div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <div class="bg-light border rounded-3 p-3 h-100">
                                <div class="small text-muted mb-1">Departure date</div>
                                <div class="fw-semibold">{{ issue.trip.departureDate|date('d/m/Y') }}</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="bg-light border rounded-3 p-3 h-100">
                                <div class="small text-muted mb-1">Arrival date</div>
                                <div class="fw-semibold">{{ issue.trip.arrivalDate|date('d/m/Y') }}</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="bg-light border rounded-3 p-3 h-100">
                                <div class="small text-muted mb-1">Departure location</div>
                                <div class="fw-semibold">{{ issue.trip.departureLocation }}</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="bg-light border rounded-3 p-3 h-100">
                                <div class="small text-muted mb-1">Destination</div>
                                <div class="fw-semibold">{{ issue.trip.arrivalLocation }}</div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="bg-light border rounded-3 p-3 h-100">
                                <div class="small text-muted mb-1">Participant comment</div>
                                <p class="mb-0 text-pre-wrap">{{ issue.comment }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-5">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-header bg-white p-4 border-bottom rounded-top-4">
                    <h2 class="h5 mb-0 fw-bold">Participants</h2>
                </div>

                <div class="card-body p-4">
                    <div class="d-flex flex-column gap-3 mb-4">
                        <div class="bg-light border rounded-3 p-3">
                            <div class="small text-muted mb-1">Driver</div>
                            <div class="fw-semibold">{{ issue.driver ? issue.driver.username : 'Utilisateur supprimé' }}</div>
                            <div class="small text-muted">{{ issue.driver ? issue.driver.email : 'Email indisponible' }}</div>
                        </div>

                        <div class="bg-light border rounded-3 p-3">
                            <div class="small text-muted mb-1">Participant</div>
                            <div class="fw-semibold">{{ issue.participant ? issue.participant.username : 'Utilisateur supprimé' }}</div>
                            <div class="small text-muted">{{ issue.participant ? issue.participant.email : 'Email indisponible' }}</div>
                        </div>
                    </div>

                    <div class="bg-light border rounded-3 p-3">
                        <div class="small text-muted mb-1">Current incident status</div>
                        <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                            <span class="badge rounded-pill text-bg-secondary fw-medium">{{ issueStatusLabels[issue.status]|default(issue.status) }}</span>
                            {% if issue.resolvedAt %}
                                <span class="badge bg-white text-dark border rounded-pill fw-normal">Traite le {{ issue.resolvedAt|date('d/m/Y H:i') }}</span>
                            {% endif %}
                        </div>

                        {% if issue.resolvedBy %}
                            <p class="mt-2 mb-1 small text-muted">
                                Resolution par {{ issue.resolvedBy.username }}
                            </p>
                        {% endif %}

                        {% if issue.resolutionNote %}
                            <div class="mt-3">
                                <div class="small text-muted mb-1">Resolution note</div>
                                <p class="mb-0 text-pre-wrap">{{ issue.resolutionNote }}</p>
                            </div>
                        {% endif %}
                    </div>

                    {% if issue.status == 'open' %}
                        <div class="mt-4 pt-4 border-top">
                            <h3 class="h6 fw-bold mb-3">Traiter le signalement</h3>

                            {{ form_start(resolutionForm, {action: path('app_tripIssue_resolve', {id: issue.id})}) }}
                                <div class="mb-3">
                                    {{ form_label(resolutionForm.resolution, null, {label_attr: {class: 'small text-muted fw-bold d-block mb-2'}}) }}
                                    <div class="d-flex flex-column gap-2">
                                        {% for choice in resolutionForm.resolution %}
                                            <label class="d-flex align-items-center gap-2 p-3 border rounded-3 bg-light custom-radio-option cursor-pointer m-0">
                                                {{ form_widget(choice, {attr: {class: 'form-check-input mt-0 custom-radio-input'}}) }}
                                                <span class="fw-medium">{{ choice.vars.label }}</span>
                                            </label>
                                        {% endfor %}
                                    </div>
                                    {{ form_errors(resolutionForm.resolution) }}
                                </div>

                                <div class="mb-4">
                                    {{ form_label(resolutionForm.resolutionNote, null, {label_attr: {class: 'small text-muted fw-bold mb-1'}}) }}
                                    {{ form_widget(resolutionForm.resolutionNote, {attr: {class: 'form-control shadow-none border rounded-3'}}) }}
                                    {{ form_errors(resolutionForm.resolutionNote) }}
                                </div>

                                <button type="submit" class="btn btn-vert w-100 py-2 rounded-3 fw-bold">Enregistrer la resolution</button>
                            {{ form_end(resolutionForm) }}
                        </div>
                    {% else %}
                        <div class="mt-4 pt-4 border-top">
                            <p class="mb-0 small text-muted">
                                Ce signalement a deja ete traite. Vous pouvez consulter les details ci-dessus.
                            </p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
