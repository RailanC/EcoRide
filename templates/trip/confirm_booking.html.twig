{% extends 'base.html.twig' %}

{% block title %}Confirmer votre participation{% endblock %}

{% block body %}
<div class="container py-5" style="max-width: 720px;">
    <h1>Confirmer votre participation</h1>

    <p>
        Vous allez reserver une place pour le trajet
        {{ trip.departureLocation }} &rarr; {{ trip.arrivalLocation }}.
    </p>

    <p>
        Vous paierez <strong>{{ priceInCredits }}</strong> credits.
        Le conducteur recevra <strong>{{ driverReceives }}</strong> credits.
    </p>

    <p class="text-muted">
        Une commission fixe de {{ platformFee }} credits est deduite pour chaque reservation.
    </p>

    <form method="post" action="{{ path('app_covoiturage_participer_confirm', {id: trip.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('participer_' ~ trip.id) }}">
        <button type="submit" class="btn btn-primary">Confirmer</button>
        <a href="{{ path('app_covoiturage_show', {id: trip.id}) }}" class="btn btn-secondary">Annuler</a>
    </form>
</div>
{% endblock %}
