{% extends 'base.html.twig' %}

{% block title %}Valider le trajet
{% endblock %}

{% block body %}
	<div class="container py-5" style="max-width: 820px;">
		<a href="{{ path('app_profile_trips') }}#history" class="btn-details text-decoration-none">Retour a mes trajets</a>

		{% for msg in app.flashes('success') %}
			<div class="alert alert-success mt-3">{{ msg }}</div>
		{% endfor %}
		{% for msg in app.flashes('error') %}
			<div class="alert alert-danger mt-3">{{ msg }}</div>
		{% endfor %}
		{% for msg in app.flashes('info') %}
			<div class="alert alert-info mt-3">{{ msg }}</div>
		{% endfor %}

		<div class="travel-hero mt-2 mb-4">
			<div class="travel-hero-content">
				<div class="travel-hero-route">
					{{ trip.departureLocation }}
					<span class="arrow-icon">&rarr;</span>
					{{ trip.arrivalLocation }}
				</div>
				<div class="travel-hero-sub">
					Confirmez comment le trajet avec
					{{ trip.driver.username }}
					s'est passe.
				</div>
			</div>
			<div class="travel-hero-dates">
				{{ trip.departureDate|date('d M Y') }}
				a
				{{ trip.departureTime|date('H:i') }}
			</div>
		</div>

		<div class="section-header">
			<span class="section-title">Recapitulatif</span>
		</div>

		<div class="contact-card mb-4">
			<div class="trip-schedule-grid">
				<div class="trip-schedule-card">
					<div class="trip-schedule-label">Depart</div>
					<div class="trip-schedule-city">{{ trip.departureLocation }}</div>
					<div class="trip-schedule-value">{{ trip.departureDate|date('d/m/Y') }}</div>
					<div class="trip-schedule-time">{{ trip.departureTime|date('H:i') }}</div>
				</div>
				<div class="trip-schedule-card trip-schedule-card--arrival">
					<div class="trip-schedule-label">Arrivee</div>
					<div class="trip-schedule-city">{{ trip.arrivalLocation }}</div>
					<div class="trip-schedule-value">{{ trip.arrivalDate|date('d/m/Y') }}</div>
					<div class="trip-schedule-time">{{ trip.arrivalTime|date('H:i') }}</div>
				</div>
			</div>

			<div class="row g-3 mt-1">
				<div class="col-md-6">
					<label class="contact-label">Conducteur</label>
					<div class="meta-item" style="font-size:0.95rem;">{{ trip.driver.username }}</div>
				</div>
				<div class="col-md-6">
					<label class="contact-label">Statut actuel</label>
					<div class="meta-item" style="font-size:0.95rem;">{{ trip.status }}</div>
				</div>
			</div>
		</div>

		<div class="section-header">
			<span class="section-title">Votre retour</span>
		</div>

		<div class="contact-card">
			<p style="color:var(--text-muted);margin-bottom:1.25rem;">
				Votre reponse permet de confirmer la fin du trajet et de declencher la suite du workflow.
			</p>

			{{ form_start(form) }}
			<div class="mb-4">
				{{ form_label(form.outcome, null, {label_attr: {class: 'contact-label'}}) }}
				<div class="trip-rating-shell mt-2">
					<div class="trip-rating-card">
						<div class="trip-rating-title">Comment s est passe votre trajet ?</div>
						<div class="trip-rating-subtitle">Selectionnez une note de 1 a 5 etoiles.</div>
						<div class="trip-rating-stars" data-trip-rating>
							{% for choice in form.outcome %}
								{% set score = choice.vars.value + 0 %}
								{{ form_widget(choice) }}
								<label for="{{ choice.vars.id }}" title="{{ score }}/5" aria-label="{{ score }} etoiles" data-rating-value="{{ score }}" data-rating-title="{% if score >= 5 %}Excellent trajet{% elseif score == 4 %}Bon trajet{% elseif score == 3 %}Trajet mitige{% elseif score == 2 %}Probleme important{% else %}Tres mauvais trajet{% endif %}" data-rating-note="{% if score >= 4 %}Cette note valide le trajet. Le commentaire reste optionnel si vous voulez ajouter un detail.{% elseif score == 3 %}Cette note demande un commentaire pour expliquer ce qui s est moins bien passe.{% else %}Cette note signale un probleme. Un commentaire sera requis et le trajet passera en suivi.{% endif %}">&#9733;</label>
							{% endfor %}
						</div>
						<div class="trip-rating-feedback" data-trip-rating-feedback>
							<div class="trip-rating-feedback-title" data-trip-rating-title></div>
							<div class="trip-rating-feedback-note" data-trip-rating-note></div>
						</div>
					</div>
				</div>
				{{ form_errors(form.outcome) }}
			</div>

			<div class="mb-4">
				{{ form_label(form.comment, null, {label_attr: {class: 'contact-label'}}) }}
				{{ form_widget(form.comment, {
                    attr: {
                        class: 'form-control trip-validate-comment',
                        rows: 5,
                        placeholder: 'Ajoutez des details, surtout si vous donnez 3 etoiles ou moins.'
                    }
                }) }}
				<div style="font-size:0.82rem;color:var(--text-muted);margin-top:0.45rem;">
					Le commentaire est optionnel pour 4 ou 5 etoiles, et requis pour 3 etoiles ou moins.
				</div>
				{{ form_errors(form.comment) }}
			</div>

			<div class="d-flex gap-2 flex-wrap">
				<button type="submit" class="btn btn-vert">Envoyer mon retour</button>
				<a href="{{ path('app_profile_trips') }}#history" class="btn btn-outline-light">Retour</a>
			</div>
			{{ form_end(form) }}
		</div>
	</div>
{% endblock %}

{% block javascript %}
	{{ parent() }}
	<script type="module" src="{{ asset('js/tripScripts.js') }}"></script>
{% endblock %}
