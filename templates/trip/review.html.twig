{% extends 'base.html.twig' %}

{% block title %}Laisser un avis{% endblock %}

{% block body %}
<div class="container py-5" style="max-width: 820px;">
    <div class="contact-card">
        <h1 class="contact-title" style="text-align:left;">Laisser un avis</h1>
        <p style="color:var(--text-muted);">
            Votre avis restera en attente de moderation avant publication.
        </p>

        {{ form_start(form) }}
            {{ form_row(form.rating) }}
            {{ form_row(form.comment) }}
            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-vert">Soumettre l avis</button>
                <a href="{{ path('app_profile_trips') }}" class="btn btn-outline-light">Retour</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
