{% extends 'base.html.twig' %}

{% block title %}Mon Profil — EcoRide{% endblock %}

{% block body %}
<div class="container py-5">

    {# ── PAGE HEADER ─────────────────────────────────────────────── #}
    <div class="mb-5">
        <p class="search-eyebrow mb-1">Espace personnel</p>
        <h1 class="fw-bold" style="font-family:'Sora',sans-serif;font-size:2rem;letter-spacing:-0.02em;">
            Mon profil
        </h1>
        <p style="color:var(--text-muted);font-size:0.92rem;margin-top:0.25rem;">
            Gérez vos informations et vos véhicules
        </p>
    </div>

    {# ── FLASH MESSAGES ───────────────────────────────────────────── #}
    {% set successFlashes = app.flashes('success') %}
    {% set errorFlashes = app.flashes('error') %}
    {% for msg in successFlashes %}
        <div class="mb-4 px-3 py-2 rounded-3 d-flex align-items-center gap-2"
             style="background:var(--accent-soft);border:1px solid rgba(94,188,103,.22);color:var(--vert);font-size:.88rem;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            {{ msg }}
        </div>
    {% endfor %}
    {% for msg in errorFlashes %}
        <div class="mb-4 px-3 py-2 rounded-3 d-flex align-items-center gap-2"
             style="background:rgba(220,53,69,.12);border:1px solid rgba(220,53,69,.25);color:#f28b82;font-size:.88rem;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            {{ msg }}
        </div>
    {% endfor %}

    {{ form_start(profileForm, {
        action: path('app_profile_update'),
        method: 'POST',
        attr: { 'data-turbo': 'false' }
    }) }}
        <div class="row g-4">
            {# ══════════════════════════════════════════════════════
               LEFT COLUMN — Identity + Role
               ══════════════════════════════════════════════════════ #}
            <div class="col-12 col-lg-4">

                {# Avatar card #}
                <div class="contact-card text-center mb-4" style="padding:2rem 1.5rem;">
                    <div class="mx-auto mb-3 d-flex align-items-center justify-content-center fw-bold"
                         style="width:80px;height:80px;border-radius:20px;background:linear-gradient(135deg,#263446,#1a1d27);border:1px solid rgba(255,255,255,.08);font-family:'Sora',sans-serif;font-size:1.6rem;color:var(--text-muted);">
                        {{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}
                    </div>
                    <p class="fw-bold mb-0" style="font-family:'Sora',sans-serif;font-size:1.1rem;">
                        {{ app.user.firstName }} {{ app.user.lastName }}
                    </p>
                    <p style="font-size:.82rem;color:var(--text-muted);margin-top:.2rem;">
                        {{ app.user.email }}
                    </p>

                    {# Role badges #}
                    <div class="d-flex gap-2 justify-content-center mt-3 flex-wrap" id="roleBadges">
                        <span class="badge-eco" id="badgePassenger" style="display:none;">Passager</span>
                        <span class="badge-eco" id="badgeDriver"
                              style="display:none;background:rgba(94,188,103,.12);border-color:rgba(94,188,103,.22);color:var(--vert);">
                            Conducteur
                        </span>
                    </div>
                </div>

                {# Personal info card #}
                <div class="contact-card mb-4">
                    <h2 class="contact-title" style="font-size:1rem;text-align:left;">Informations personnelles</h2>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            {{ form_row(profileForm.firstName) }}
                        </div>
                        <div class="col-6">
                            {{ form_row(profileForm.lastName) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        {{ form_label(profileForm.email) }}
                        <div class="position-relative">
                            <span class="position-absolute d-flex align-items-center"
                                  style="left:.85rem;top:50%;transform:translateY(-50%);color:var(--vert);pointer-events:none;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
                                </svg>
                            </span>
                            {{ form_widget(profileForm.email )}}
                        </div>
                        {{ form_errors(profileForm.email)}}
                    </div>

                    <div class="mb-3">
                        {{ form_label(profileForm.phone) }}
                        <div class="position-relative">
                            <span class="position-absolute d-flex align-items-center"
                                  style="left:.85rem;top:50%;transform:translateY(-50%);color:var(--vert);pointer-events:none;">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.58 1.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.77a16 16 0 0 0 6.29 6.29l1.84-1.84a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
                                </svg>
                            </span>
                            {{ form_widget(profileForm.phone )}}
                        </div>
                        {{ form_errors(profileForm.phone)}}
                    </div>

                    <div class="mb-3">
                        {{ form_label(profileForm.address) }}
                        <div class="position-relative">
                            <span class="position-absolute d-flex align-items-center"
                                  style="left:.85rem;top:50%;transform:translateY(-50%);color:var(--vert);pointer-events:none;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-house" viewBox="0 0 16 16">
                                    <path d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.708L2 8.207V13.5A1.5 1.5 0 0 0 3.5 15h9a1.5 1.5 0 0 0 1.5-1.5V8.207l.646.647a.5.5 0 0 0 .708-.708L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293zM13 7.207V13.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V7.207l5-5z"/>
                                </svg>
                            </span>
                            {{ form_widget(profileForm.address )}}
                        </div>
                        {{ form_errors(profileForm.address)}}
                    </div>

                    <div class="mb-0">
                        {{ form_row(profileForm.bio) }}
                    </div>
                </div>

                {# Change password card #}
                <div class="contact-card">
                    <h2 class="contact-title" style="font-size:1rem;text-align:left;">Changer le mot de passe</h2>

                    <div class="mb-3">
                        {{ form_label(profileForm.currentPassword) }}
                        <div class="position-relative">
                            {{ form_widget(profileForm.currentPassword) }}
                            <button type="button" onclick="togglePw('profile_form_currentPassword',this)"
                                    class="position-absolute border-0 bg-transparent d-flex align-items-center p-0"
                                    style="right:.85rem;top:50%;transform:translateY(-50%);color:var(--text-muted);cursor:pointer;">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                                </svg>
                            </button>
                        </div>
                        {{ form_errors(profileForm.currentPassword) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(profileForm.newPassword.first) }}
                        <div class="position-relative">
                            {{ form_widget(profileForm.newPassword.first) }}
                            <button type="button" onclick="togglePw('profile_form_newPassword',this)"
                                    class="position-absolute border-0 bg-transparent d-flex align-items-center p-0"
                                    style="right:.85rem;top:50%;transform:translateY(-50%);color:var(--text-muted);cursor:pointer;">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                                </svg>
                            </button>
                        </div>
                        {{ form_errors(profileForm.newPassword.first) }}
                    </div>

                    <div class="mb-0">
                        {{ form_label(profileForm.newPassword.second) }}
                        <div class="position-relative">
                            {{ form_widget(profileForm.newPassword.second) }}
                            <button type="button" onclick="togglePw('profile_form_confirmPassword',this)"
                                    class="position-absolute border-0 bg-transparent d-flex align-items-center p-0"
                                    style="right:.85rem;top:50%;transform:translateY(-50%);color:var(--text-muted);cursor:pointer;">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                                </svg>
                            </button>
                        </div>
                        {{ form_errors(profileForm.newPassword.second) }}
                    </div>
                </div>

                <div class="contact-card mt-4" style="border-color:rgba(220,53,69,.22);">
                    <h2 class="contact-title" style="font-size:1rem;text-align:left;color:#f28b82;">Zone sensible</h2>
                    <p style="font-size:.88rem;color:var(--text-muted);margin-bottom:1rem;">
                        Supprimer votre compte effacera votre profil et vos vehicules. Cette action est irreversible.
                    </p>
                    <button type="submit" form="delete-profile-form" class="btn btn-outline-danger rounded-pill px-4">
                        Supprimer mon compte
                    </button>
                </div>

            </div>{# /col left #}

            {# ══════════════════════════════════════════════════════
               RIGHT COLUMN — Role + Vehicles
               ══════════════════════════════════════════════════════ #}
            <div class="col-12 col-lg-8">

                {# ── ROLE SELECTOR ──────────────────────────────── #}
                <div class="contact-card mb-4">
                    <h2 class="contact-title" style="font-size:1rem;text-align:left;margin-bottom:1.25rem;">
                        Mon rôle sur EcoRide
                    </h2>

                    <div class="row g-3" id="roleCards">

                        {# Passenger #}
                        <div class="col-12 col-sm-4">
                            <label class="role-card d-block" for="rolePassenger"
                                   style="border:1px solid rgba(255,255,255,.08);border-radius:var(--radius-sm);padding:1.25rem 1rem;cursor:pointer;transition:all .18s ease;text-align:center;">
                                <input type="radio" id="rolePassenger" name="role" value="passenger"
                                       class="d-none role-radio"
                                       {{ app.user.type == 'passenger' ? 'checked' : '' }} />
                                <div class="mb-2 mx-auto d-flex align-items-center justify-content-center"
                                     style="width:44px;height:44px;border-radius:12px;background:rgba(94,188,103,.1);border:1px solid rgba(94,188,103,.15);">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--vert)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
                                    </svg>
                                </div>
                                <p class="fw-bold mb-0" style="font-size:.9rem;font-family:'Sora',sans-serif;">Passager</p>
                                <p style="font-size:.75rem;color:var(--text-muted);margin-top:.25rem;line-height:1.3;">
                                    Je cherche des trajets
                                </p>
                            </label>
                        </div>

                        {# Driver #}
                        <div class="col-12 col-sm-4">
                            <label class="role-card d-block" for="roleDriver"
                                   style="border:1px solid rgba(255,255,255,.08);border-radius:var(--radius-sm);padding:1.25rem 1rem;cursor:pointer;transition:all .18s ease;text-align:center;">
                                <input type="radio" id="roleDriver" name="role" value="driver"
                                       class="d-none role-radio"
                                       {{ app.user.type == 'driver' ? 'checked' : '' }} />
                                <div class="mb-2 mx-auto d-flex align-items-center justify-content-center"
                                     style="width:44px;height:44px;border-radius:12px;background:rgba(94,188,103,.1);border:1px solid rgba(94,188,103,.15);">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--vert)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                                    </svg>
                                </div>
                                <p class="fw-bold mb-0" style="font-size:.9rem;font-family:'Sora',sans-serif;">Conducteur</p>
                                <p style="font-size:.75rem;color:var(--text-muted);margin-top:.25rem;line-height:1.3;">
                                    Je propose des trajets
                                </p>
                            </label>
                        </div>

                        {# Both #}
                        <div class="col-12 col-sm-4">
                            <label class="role-card d-block" for="roleBoth"
                                   style="border:1px solid rgba(255,255,255,.08);border-radius:var(--radius-sm);padding:1.25rem 1rem;cursor:pointer;transition:all .18s ease;text-align:center;">
                                <input type="radio" id="roleBoth" name="role" value="both"
                                       class="d-none role-radio"
                                       {{ app.user.type == 'both' ? 'checked' : '' }} />
                                <div class="mb-2 mx-auto d-flex align-items-center justify-content-center"
                                     style="width:44px;height:44px;border-radius:12px;background:rgba(167,217,48,.1);border:1px solid rgba(167,217,48,.18);">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--lime)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                    </svg>
                                </div>
                                <p class="fw-bold mb-0" style="font-size:.9rem;font-family:'Sora',sans-serif;">Les deux</p>
                                <p style="font-size:.75rem;color:var(--text-muted);margin-top:.25rem;line-height:1.3;">
                                    Je conduis et je voyage
                                </p>
                            </label>
                        </div>

                    </div>
                </div>

                {# ── DRIVER SECTION (shown when driver or both) ─── #}
                <div id="driverSection" style="display:none;">

                    {# ── VEHICLES ────────────────────────────────── #}
                    <div class="contact-card mb-4">
                        <h2 class="contact-title mb-4" style="font-size:1rem;text-align:left;">
                            Mes véhicules
                        </h2>

                        {# Vehicle collection with custom rendering #}
                        <div id="vehicleList" class="vehicle-collection">
                            {% for vehicleForm in profileForm.vehicles %}
                                <div class="vehicle-block mb-4" style="border:1px solid rgba(255,255,255,.07);border-radius:var(--radius-sm);padding:1.25rem;background:rgba(15,17,23,.5);" 
                                data-index="{{ loop.index0 }}"
                                data-existing="{{ vehicleForm.vars.data.id ? '1' : '0' }}">
                                    <div class="row g-3">
                                        <div class="col-12 col-sm-6">
                                            {{ form_row(vehicleForm.registrationNumber) }}
                                        </div>
                                        <div class="col-12 col-sm-6">
                                            {{ form_row(vehicleForm.firstRegistrationDate) }}
                                        </div>
                                        <div class="col-12 col-sm-4">
                                            {{ form_row(vehicleForm.brand) }}
                                        </div>
                                        <div class="col-12 col-sm-4">
                                            {{ form_row(vehicleForm.model) }}
                                        </div>
                                        <div class="col-12 col-sm-4">
                                            {{ form_row(vehicleForm.color) }}
                                        </div>
                                        <div class="col-12 col-sm-4">
                                            {{ form_row(vehicleForm.energyType) }}
                                        </div>
                                        <div class="col-12 col-sm-6">
                                            {{ form_row(vehicleForm.places) }}
                                        </div>
                                    </div>

                                    {# Preferences Section #}
                                    <div class="mt-4 pt-3" style="border-top:1px solid rgba(255,255,255,.07);">
                                        <div class="d-flex align-items-center justify-content-between mb-3">
                                            <p class="contact-label mb-0" style="font-size:.78rem;">Préférences à bord</p>
                                            <span style="font-size:.7rem;color:var(--text-muted);">Auto-sélectionné selon votre rôle</span>
                                        </div>
                                        {% set prefs = vehicleForm.vars.data.preferences %}
                                        <div class="row g-2 mb-3">
                                            <div class="col-12 col-sm-6">
                                                <div class="pref-toggle" data-vehicle-index="{{ loop.index0 }}" data-pref-name="smoking">
                                                    <button type="button" class="pref-btn {{ prefs.smoking == 0 ? 'active' : '' }}" data-pref-value="0">
                                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                            <line x1="1" y1="1" x2="23" y2="23"/><path d="M20.84 14.12a4 4 0 0 0-4.99-4.12"/>
                                                        </svg>
                                                        Pas de tabac
                                                    </button>
                                                    <button type="button" class="pref-btn {{ prefs.smoking == 1 ? 'active' : '' }}" data-pref-value="1">
                                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="M18 12h2a2 2 0 0 1 2 2v0a2 2 0 0 1-2 2h-2"/><path d="M2 16h16"/><path d="M22 8c0-2.2-1.8-4-4-4-1.4 0-2.6.7-3.4 1.8"/>
                                                        </svg>
                                                        Fumeurs OK
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="col-12 col-sm-6">
                                                <div class="pref-toggle" data-vehicle-index="{{ loop.index0 }}" data-pref-name="animals">
                                                    <button type="button" class="pref-btn {{ prefs.animals == 0 ? 'active' : '' }}" data-pref-value="0">
                                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                            <line x1="1" y1="1" x2="23" y2="23"/>
                                                        </svg>
                                                        Pas d'animaux
                                                    </button>
                                                    <button type="button" class="pref-btn {{ prefs.animals == 1 ? 'active' : '' }}" data-pref-value="1">
                                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="M10 5.172C10 3.374 8.24 2 6 2c-2.24 0-4 1.374-4 3.172 0 .356.077.7.215 1.018M14 5.172C14 3.374 15.76 2 18 2c2.24 0 4 1.374 4 3.172 0 .356-.077.7-.215 1.018M6 10c-2 0-4 1.5-4 4s2 4 4 4h12c2 0 4-1.5 4-4s-2-4-4-4H6z"/>
                                                        </svg>
                                                        Animaux OK
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    {# Hidden preferences JSON field #}
                                    <input
                                        type="hidden"
                                        id="{{ vehicleForm.preferences.vars.id }}"
                                        name="{{ vehicleForm.preferences.vars.full_name }}"
                                        value="{{ prefs|json_encode|e('html_attr') }}"
                                        data-preferences-hidden
                                    >

                                    {% do vehicleForm.preferences.setRendered() %}
                                    {# Delete button #}
                                    <button type="button" class="btn btn-sm btn-outline-danger mt-3" onclick="this.closest('.vehicle-block').remove()">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                                            <polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                        </svg>
                                        Supprimer ce véhicule
                                    </button>
                                </div>
                            {% endfor %}
                        </div>

                        {# Add vehicle button #}
                        <button type="button" id="addVehicleBtn" class="btn btn-vert d-flex align-items-center gap-2 mt-4" style="font-size:.82rem;padding:.45rem 1rem;border-radius:999px;">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                            </svg>
                            Ajouter un véhicule
                        </button>
                    </div>{# /vehicles card #}

                </div>{# /driverSection #}

                {# ── PASSENGER INFO BANNER (shown when passenger only) ─ #}
                <div id="passengerSection" style="display:none;">
                    <div class="contact-card mb-4 d-flex align-items-center gap-3"
                         style="background:var(--accent-soft);border-color:rgba(94,188,103,.18);">
                        <div style="flex-shrink:0;">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--vert)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                            </svg>
                        </div>
                        <div>
                            <p class="fw-bold mb-0" style="font-size:.92rem;font-family:'Sora',sans-serif;">Mode Passager</p>
                            <p style="font-size:.82rem;color:var(--text-muted);margin:0;">
                                En tant que passager, aucun véhicule n'est requis. Vous pouvez directement chercher des trajets disponibles.
                            </p>
                        </div>
                    </div>
                </div>

                {# ── SAVE BUTTON ─────────────────────────────────── #}
                <div class="text-end">
                    <button type="submit" class="btn btn-vert px-5 rounded-pill fw-semibold"
                            style="padding-top:.75rem;padding-bottom:.75rem;">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="me-2">
                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/>
                        </svg>
                        Sauvegarder
                    </button>
                </div>

                <div class="contact-card mt-4 d-none" style="border-color:rgba(220,53,69,.22);">
                    <h2 class="contact-title" style="font-size:1rem;text-align:left;color:#f28b82;">Zone sensible</h2>
                    <p style="font-size:.88rem;color:var(--text-muted);margin-bottom:1rem;">
                        Supprimer votre compte effacera votre profil et vos véhicules. Cette action est irréversible.
                    </p>
                    <button type="submit" form="delete-profile-form" class="btn btn-outline-danger rounded-pill px-4">
                        Supprimer mon compte
                    </button>
                </div>

            </div>{# /col right #}
        </div>{# /row #}
    {{ form_end(profileForm) }}
    <form id="delete-profile-form" method="post" action="{{ path('app_profile_delete') }}" onsubmit="return confirm('Voulez-vous vraiment supprimer votre compte ?');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete_profile') }}">
    </form>
</div>

