{% extends 'base.html.twig' %}

{% block title %}Contact | EcoRide{% endblock %}

{% block body %}
<div class="container py-5" style="max-width: 760px;">
    <div class="contact-card">
        <p class="search-eyebrow mb-1">Besoin d'aide ?</p>
        <h1 class="fw-bold mb-3" style="font-family:'Sora',sans-serif;">Contact</h1>
        <p style="color:var(--text-muted);">
            Une question sur EcoRide ? Écrivez-nous et nous vous répondrons rapidement.
        </p>

        <form class="mt-4">
            <div class="contact-field mb-3">
                <label class="contact-label">Nom</label>
                <input type="text" class="form-control contact-input" placeholder="Votre nom">
            </div>
            <div class="contact-field mb-3">
                <label class="contact-label">Email</label>
                <input type="email" class="form-control contact-input" placeholder="votre@email.com">
            </div>
            <div class="contact-field mb-4">
                <label class="contact-label">Message</label>
                <textarea class="form-control contact-input" rows="5" placeholder="Votre message"></textarea>
            </div>
            <button type="submit" class="btn btn-vert px-4 rounded-pill">Envoyer</button>
        </form>
    </div>
</div>
{% endblock %}
