{% extends 'base.html.twig' %}

{% block title %}Créer un covoiturage{% endblock %}

{% block body %}
<div class="container py-5" style="max-width: 880px;">

    <div class="section-header">
        <span class="section-title">Informations du trajet</span>
    </div>

    <div class="contact-card">
        <form method="post">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="contact-label" for="departure_city">Ville de départ</label>
                    <input
                        type="text"
                        id="departure_city"
                        name="departure_city"
                        class="form-control contact-input"
                        placeholder="Ex. Paris"
                        required
                    >
                </div>

                <div class="col-md-6">
                    <label class="contact-label" for="arrival_city">Ville d'arrivée</label>
                    <input
                        type="text"
                        id="arrival_city"
                        name="arrival_city"
                        class="form-control contact-input"
                        placeholder="Ex. Lyon"
                        required
                    >
                </div>

                <div class="col-md-6">
                    <label class="contact-label" for="departure_date">Date de départ</label>
                    <input
                        type="date"
                        id="departure_date"
                        name="departure_date"
                        class="form-control contact-input"
                        required
                    >
                </div>

                <div class="col-md-6">
                    <label class="contact-label" for="departure_time">Heure de départ</label>
                    <input
                        type="time"
                        id="departure_time"
                        name="departure_time"
                        class="form-control contact-input"
                    >
                </div>

                <div class="col-md-6">
                    <label class="contact-label" for="price">Prix (€)</label>
                    <input
                        type="number"
                        id="price"
                        name="price"
                        class="form-control contact-input"
                        min="0"
                        placeholder="Ex. 15"
                    >
                </div>

                <div class="col-md-6">
                    <label class="contact-label" for="seats">Places disponibles</label>
                    <input
                        type="number"
                        id="seats"
                        name="seats"
                        class="form-control contact-input"
                        min="1"
                        placeholder="Ex. 3"
                    >
                </div>

                <div class="col-12">
                    <label class="contact-label" for="car">Voiture utilisée</label>
                    <select
                        id="car"
                        class="form-select contact-input"
                        name="car"
                    >
                        <option value="">Choisir une voiture</option>
                        {% for voiture in voitures %}
                            <option value="{{ voiture.id }}">
                                {{ voiture.marque.libelle }} - {{ voiture.modele }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <hr class="trips-divider">

            <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
                <button type="submit" class="btn-search" style="width:auto; border-radius: 12px; padding: 0.85rem 1.4rem;">
                    Publier le covoiturage
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}