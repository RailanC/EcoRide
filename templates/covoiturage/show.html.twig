{% extends 'base.html.twig' %}

{% block title %}Détails du covoiturage{% endblock %}

{% block body %}
<div class="container py-5">

    <h1 class="mb-4">Détails du trajet</h1>

    <div class="card shadow-sm p-4">

        <div class="row mb-4">

            <div class="col-md-8">
                <h4>
                    {{ covoiturage.lieuDepart }} → {{ covoiturage.lieuArrivee }}
                </h4>

                <p class="text-muted">
                    {{ covoiturage.dateDepart|date('d/m/Y') }}
                    à
                    {{ covoiturage.dateDepart|date('H:i') }}
                </p>
            </div>

            <div class="col-md-4 text-md-end">
                <h3 class="text-success">
                    {{ covoiturage.prixPersonne }} €
                </h3>
            </div>

        </div>

        <hr>

        <div class="row mb-3">
            <div class="col-md-6">
                <strong>Places disponibles :</strong>
                {{ covoiturage.totalPlaces }}
            </div>

            <div class="col-md-6">
                <strong>Voiture :</strong>
                {{ covoiturage.voiture.marque.libelle }}
                {{ covoiturage.voiture.modele }}
            </div>
        </div>

        <div class="row mb-3">

            <div class="col-md-6">
                <strong>Conducteur :</strong>
                {{ covoiturage.utilisateur.pseudo }}
            </div>

            <div class="col-md-6">
                <strong>Note :</strong>
                ⭐ {{ covoiturage.utilisateur.note ?? 'N/A' }}
            </div>

        </div>

        <div class="mb-3">
            {% if covoiturage.voiture.energie == "Electrique" %}
                <span class="badge bg-success">
                    Trajet écologique ⚡
                </span>
            {% else %}
                <span class="badge bg-secondary">
                    Trajet standard
                </span>
            {% endif %}
        </div>

        <div class="mt-4">

            <a href="{{ path('app_covoiturage') }}" class="btn btn-outline-secondary">
                Retour
            </a>

            <a href="#" class="btn btn-success">
                Réserver une place
            </a>

        </div>

    </div>

</div>
{% endblock %}