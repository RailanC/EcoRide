{% extends 'base.html.twig' %}

{% block body %}

<div class="container py-5">

    <h2 class="mb-4">
        Trajets disponibles
        {% if from and to %}
            : {{ from }} → {{ to }}
        {% endif %}
    </h2>
    <div class="card shadow-sm p-4">
    {% if covoiturages is empty %}
        <div class="alert alert-warning">
            Aucun covoiturage trouvé pour cette date.
        </div>
    {% endif %}

    <div class="row">

        {% for trip in covoiturages %}

        <div class="col-md-6 col-lg-4 mb-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h5 class="card-title">
                        {{ trip.lieuDepart }} → {{ trip.lieuArrivee }}
                    </h5>

                    <p class="text-muted">
                        {{ trip.dateDepart|date('d/m/Y H:i') }}
                    </p>

                    <p>
                        💺 {{ trip.totalPlaces }} places restantes
                    </p>

                    <p>
                        💰 {{ trip.prixPersonne }} €
                    </p>

                    <p>
                        Conducteur : {{ trip.utilisateur.pseudo }}
                    </p>

                    {% if trip.voiture.energie == "Electrique" %}
                        <span class="badge bg-success">Eco-friendly</span>
                    {% endif %}

                </div>

                <div class="card-footer text-end">

                    <a href="{{ path('app_covoiturage_show', {id: trip.id}) }}"
                       class="btn btn-sm btn-success">
                        Détails
                    </a>

                </div>

            </div>

        </div>

        {% endfor %}

    </div>

</div>

{% endblock %}