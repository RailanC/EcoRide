{% extends 'base.html.twig' %}

{% block body %}
<div class="container py-5" style="max-width: 1300px;">
<form method="get" action="{{ path('app_covoiturage') }}" class="mb-4">
    <div class="search-pill mb-3">
      <div class="row g-0 align-items-stretch w-100">

        <div class="col-6 col-lg search-field border-end-mobile">
          <span class="field-label">Départ</span>
          <span class="field-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
            </svg>
          </span>
          <input
            type="text"
            name="departure"
            id="from"
            placeholder="Ville de départ"
            autocomplete="off"
            class="form-control"
            value="{{ app.request.query.get('departure') }}"
          />
        </div>

        <div class="d-none d-lg-flex search-field search-field--swap col-lg-auto">
          <button type="button" class="swap-btn" onclick="swapCities()" title="Inverser">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 16V4m0 0L3 8m4-4l4 4M17 8v12m0 0l4-4m-4 4l-4-4"/>
            </svg>
          </button>
        </div>

        <div class="col-6 col-lg search-field">
          <span class="field-label">Destination</span>
          <span class="field-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
            </svg>
          </span>
          <input
            type="text"
            name="arrival"
            id="to"
            placeholder="Ville d’arrivée"
            autocomplete="off"
            class="form-control"
            value="{{ app.request.query.get('arrival') }}"
          />
        </div>

        <div class="col-6 col-lg search-field border-top-mobile">
          <span class="field-label">Date de départ</span>
          <span class="field-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
          </span>
          <input
            type="date"
            name="date"
            id="departure-date"
            class="form-control"
            value="{{ app.request.query.get('date') }}"
          />
        </div>

        <div class="col-12 col-lg search-field border-top-mobile">
          <span class="field-label">Voyageurs</span>
          <span class="field-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </span>
          <select name="passengers" class="form-select">
            <option value="1" {{ app.request.query.get('passengers') == '1' ? 'selected' : '' }}>1 passager</option>
            <option value="2" {{ app.request.query.get('passengers') == '2' ? 'selected' : '' }}>2 passagers</option>
            <option value="3" {{ app.request.query.get('passengers') == '3' ? 'selected' : '' }}>3 passagers</option>
            <option value="4" {{ app.request.query.get('passengers') == '4' ? 'selected' : '' }}>4 passagers</option>
            <option value="5" {{ app.request.query.get('passengers') == '5' ? 'selected' : '' }}>5+ passagers</option>
          </select>
          <span class="select-chevron">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </span>
        </div>

      </div>
    </div>

    <div class="contact-card mb-4">
      <div class="section-header mb-3">
        <span class="section-title">Filtres avancés</span>
        <span class="results-count">Affinez votre recherche</span>
      </div>

      <div class="row g-3">
        <div class="col-md-6">
          <label class="contact-label" for="max_price">Prix maximum (€)</label>
          <input
            type="number"
            id="max_price"
            name="max_price"
            class="form-control contact-input"
            min="0"
            step="1"
            placeholder="Ex. 25"
            value="{{ app.request.query.get('max_price') }}"
          >
        </div>
        
        <div class="col-md-6">
          <label class="contact-label" for="max_duration">Durée maximale (min)</label>
          <input
            type="number"
            id="max_duration"
            name="max_duration"
            class="form-control contact-input"
            min="1"
            step="1"
            placeholder="Ex. 120"
            value="{{ app.request.query.get('max_duration') }}"
          >
        </div>
        <div class="col-md-6">
          <label class="contact-label" for="min_rating">Note minimale</label>
          <select id="min_rating" name="min_rating" class="form-select contact-input">
            <option value="">Toutes</option>
            <option value="1" {{ app.request.query.get('min_rating') == '1' ? 'selected' : '' }}>1+ / 5</option>
            <option value="2" {{ app.request.query.get('min_rating') == '2' ? 'selected' : '' }}>2+ / 5</option>
            <option value="3" {{ app.request.query.get('min_rating') == '3' ? 'selected' : '' }}>3+ / 5</option>
            <option value="4" {{ app.request.query.get('min_rating') == '4' ? 'selected' : '' }}>4+ / 5</option>
            <option value="4.5" {{ app.request.query.get('min_rating') == '4.5' ? 'selected' : '' }}>4.5+ / 5</option>
          </select>
        </div>
        <div class="col-md-6">
          <label class="contact-label" for="eco">Aspect écologique</label>
          <div class="form-check mt-2">
            <input
              class="form-check-input"
              type="checkbox"
              id="eco"
              name="eco"
              value="1"
              {{ app.request.query.get('eco') ? 'checked' : '' }}
            >
            <label class="form-check-label" for="eco">
              Uniquement les trajets en voiture électrique
            </label>
          </div>
        </div>
      </div>
      <hr class="trips-divider">

      <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <a href="{{ path('app_covoiturage') }}" class="btn-details text-decoration-none">
          Réinitialiser
        </a>

        <button type="submit" class="btn-search" style="width:auto; border-radius: 12px; padding: 0.85rem 1.4rem;">
          Appliquer les filtres
        </button>
      </div>
    </div>
  </form>
  <div class="travel-hero">
    <div class="travel-hero-grid"></div>
    <div class="travel-hero-content">
      <div class="travel-hero-route">
        {% if from %}
          {{ from }}
          <span class="arrow-icon">→</span>
          {{ to }}
        {% else %}
          Tous les trajets
        {% endif %}
      </div>
      <div class="travel-hero-sub">
        Trajets disponibles au départ de {{ from ?: 'partout' }}
      </div>
    </div>

    {% if date is defined and date %}
      <div class="travel-hero-dates">📅 {{ date|date('d M Y') }}</div>
    {% endif %}
  </div>

  <div class="section-header">
    <span class="section-title">Trajets disponibles</span>
    {% if covoiturages is not empty %}
      <span class="results-count">{{ covoiturages|length }} résultat{{ covoiturages|length > 1 ? 's' }}</span>
    {% endif %}
  </div>
  
  {% if covoiturages is empty %}
    <div class="empty-state">
      <div class="empty-state-icon">🚗</div>
      <div class="empty-state-title">Aucun trajet trouvé</div>
      <p style="font-size:0.88rem;">Aucun covoiturage disponible pour cette recherche.</p>
    </div>
  {% else %}
    {% for trip in covoiturages %}
      <a href="{{ path('app_covoiturage_show', {id: trip.id}) }}" class="trip-card">

        <div class="trip-card-left">
          <div class="driver-avatar">
            {{ trip.utilisateur.pseudo|slice(0,2) }}
          </div>

          <div class="trip-info">
            <div class="trip-route">
              {{ trip.lieuDepart }}
              <span class="route-arrow">→</span>
              {{ trip.lieuArrivee }}
            </div>

            <div class="trip-meta">
              <span class="meta-item">
                🕐 {{ trip.heureDepart|date('H:i') }} → {{ trip.heureArrivee|date('H:i') }}
              </span>
              <span class="meta-item">
                {{ trip.dateDepart|date('d M Y') }}
              </span>
              <span class="meta-item">
                  Durée: {{ trip.durationInMinutes }} min
              </span>
              <span class="meta-dot"></span>
              <span class="meta-item">
                <span class="seats-chip">💺 {{ trip.totalPlaces }} place{{ trip.totalPlaces > 1 ? 's' }}</span>
              </span>
              <span class="meta-dot"></span>
              <span class="meta-item">{{ trip.utilisateur.pseudo }}</span>
              {% if trip.voiture.energie == "Electrique" %}
                <span class="meta-dot"></span>
                <span class="badge-eco">Éco</span>
              {% endif %}
            </div>
          </div>
        </div>

        <div class="trip-card-right">
          <div>
            <div class="trip-price">{{ trip.prixPersonne }} €</div>
            <div class="trip-price-label" style="text-align:right;">par personne</div>
          </div>
          <span class="btn-details">Détails</span>
        </div>

      </a>
    {% endfor %}
  {% endif %}

</div>
{% endblock %}