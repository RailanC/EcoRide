{% extends 'base.html.twig' %}

{% block title %}Confirmer votre participation{% endblock %}

{% block body %}
<h1>Confirmer votre participation</h1>

<p>
    Vous allez réserver une place pour le trajet
    {{ covoiturage.lieuDepart }} → {{ covoiturage.lieuArrivee }}.
</p>

<p>
    Cette participation coûtera <strong>{{ prixCredits }}</strong> crédits.
</p>

<form method="post" action="{{ path('app_covoiturage_participer_confirm', {id: covoiturage.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('participer_' ~ covoiturage.id) }}">
    <button type="submit" class="btn btn-primary">Confirmer</button>
    <a href="{{ path('app_covoiturage_show', {id: covoiturage.id}) }}" class="btn btn-secondary">Annuler</a>
</form>
{% endblock %}